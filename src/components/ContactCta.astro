---
/*
 * ContactCta — the shared closing conversion block (CTA-01 / blueprint 13.21, 13.40, 13.41).
 * Used by the homepage, the diensten overview and both service-detail pages (justified shared surface:
 * the same "never a dead end" conversion beat recurs on every P4 page — one component keeps the calm,
 * non-aggressive tone and the hairline-terminated composition identical everywhere). Content is passed
 * in so each page frames the invitation in its own words; no invented facts here.
 *
 * Composition (P4 correction — D-20): a restrained, asymmetric close on the base surface. A hairline top
 * rule terminates the page (idiomatic to the design system); the heading is deliberately CALM — h2 scale,
 * NOT the display scale of a hero/page-title — so the closing CTA reads as subordinate to the page's
 * photography and primary content (13.21 "niet agressief, wel zichtbaar"). Presence comes from generous
 * spacing, the gold hairline eyebrow and a confident primary action, not from monumental type. One primary
 * action; an optional single low-emphasis tertiary link. Gold stays a hairline detail, never a fill.
 *
 * P4 correction (2026-07-11, evidence-based follow-up to D-20): renders through the shared `Section`
 * component rather than a hand-written `<section class="cta section">`. Astro scopes `<style>` per
 * component, so a literal `section` class here never received `Section.astro`'s scoped `padding-block`
 * — the CTA rendered with zero vertical section padding on every P4 page. Reusing `Section` restores the
 * standard rhythm without duplicating its padding logic.
 */
import Button from './Button.astro';
import Section from './Section.astro';

interface Props {
	eyebrow?: string;
	heading: string;
	text?: string;
	primaryLabel: string;
	primaryHref: string;
	secondaryLabel?: string;
	secondaryHref?: string;
}

const {
	eyebrow = 'Contact',
	heading,
	text,
	primaryLabel,
	primaryHref,
	secondaryLabel,
	secondaryHref,
} = Astro.props;
---

<Section as="section" class="cta" aria-labelledby="cta-heading">
	<div class="cta__inner">
		<div class="cta__lead">
			<p class="t-eyebrow t-eyebrow--accent">{eyebrow}</p>
			<h2 id="cta-heading" class="t-h1 cta__heading">{heading}</h2>
			{text && <p class="cta__text">{text}</p>}
		</div>
		<div class="cta__aside">
			<div class="cta__actions">
				<Button variant="primary" href={primaryHref} trailingArrow>{primaryLabel}</Button>
				{
					secondaryLabel && secondaryHref && (
						<Button variant="tertiary" href={secondaryHref} trailingArrow>
							{secondaryLabel}
						</Button>
					)
				}
			</div>
		</div>
	</div>
</Section>

<style>
	/* P4.9 PRE-P5 CONSOLIDATION (D-29) — the recurring closing block is the site's most-repeated NON-photographic
	 * zone (home, diensten, both service pages) and read as flat base-dark + one hairline (owner Limitation 4:
	 * quiet ≠ flat). It becomes a composed premium CLOSE, tuned to be calm so it never competes with the page's
	 * photography, using three mechanisms that also serve the other limitations:
	 *   · a soft cool depth rising from the top-left (the block emerges from architectural depth, not a flat wall);
	 *   · a gentle deepening toward the FOOT so the CTA→footer boundary reads as one continuous descent into the
	 *     deep footer instead of a hard horizontal cut (Limitation 1, a cross-boundary tonal bridge);
	 *   · a FULL-WIDTH GOLD DATUM top rule — champagne caught at the left, dissolving to a neutral hairline across
	 *     the page (Limitation 3: gold gains large spatial extent while staying a 1px hairline — "larger in extent,
	 *     not heavier in weight"). It is a left-anchored architect's DIMENSION line, deliberately NOT the homepage
	 *     `.work` glow-seam (no catch-light haze, no centred highlight) — a distinct member of the datum-rule gold
	 *     family (D-28), extended to a longer trace. Static CSS, painted once; gold stays a hairline, never a fill. */
	/* P8.5 (D-76): the two hand-tuned gradients this block carried are replaced by the shared
	   `--grad-sapphire-field` token — the same construction (cool depth from the upper-left + a deepening
	   toward the foot), now richer in chroma and, more importantly, no longer a one-off. The contact page's
	   form field uses the identical token, so the site's two conversion surfaces are demonstrably the same
	   material rather than two similar-looking guesses. Still additive light over the page's own
	   background, never an opaque panel. */
	.cta {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		background: var(--grad-sapphire-field);
	}
	/* Gold datum top rule (champagne caught at the left → neutral hairline across the full width). */
	.cta::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 1px;
		z-index: 1;
		pointer-events: none;
		background: var(--grad-datum); /* P8.6 (D-77) — the shared datum, see tokens.css */
	}
	/* A short vertical gold riser at the left forms a precise architect's corner bracket (a partial frame — gold
	   spatial extent as structure, not decoration). Sits at the section's left edge, clear of the content. */
	.cta::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: clamp(1.8rem, 1.2rem + 2vw, 3rem);
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(180deg, rgba(var(--p-champagne-rgb), 0.82) 0%, rgba(var(--p-gold-rgb), 0) 100%);
	}
	.cta__inner {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: var(--space-xl) var(--space-3xl);
		align-items: center;
	}
	.cta__heading {
		max-width: 22ch;
		margin-top: var(--space-md);
	}
	.cta__text {
		margin-top: var(--space-md);
		max-width: 46ch;
		color: var(--color-text-secondary);
	}
	.cta__aside {
		justify-self: end;
	}
	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-md) var(--space-xl);
	}
	@media (max-width: 52rem) {
		.cta__inner {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
			align-items: start;
		}
		.cta__heading {
			max-width: 20ch;
		}
		.cta__aside {
			justify-self: start;
			margin-top: var(--space-sm);
		}
	}
</style>
