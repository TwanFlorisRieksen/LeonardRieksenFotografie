---
/*
 * PhotoFrame — an openable photograph (P6 recovery — D-34 / PH-13).
 *
 * Wraps <Media> in an anchor that points at an OPTIMISED derivative (never the source master — PH-08).
 * Without JavaScript the anchor simply opens that large image (photography stays fully usable, MOT-08 /
 * progressive enhancement). With JavaScript, Lightbox.astro intercepts the click and opens the full
 * viewer, cycling within the shared `group`. The image itself is shown WHOLE by default (intrinsic ratio,
 * no forced crop — 2.14/8.14); a `ratio` may be opted in only for deliberate framed slots.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	caption?: string;
	group: string;
	widths?: number[];
	sizes?: string;
	priority?: boolean;
	ratio?: string;
	fit?: 'cover' | 'contain';
	position?: string;
	showCaption?: boolean;
	class?: string;
	mediaClass?: string;
}

const {
	image,
	alt,
	caption,
	group,
	widths = [480, 800, 1200, 1700],
	sizes = '100vw',
	priority = false,
	ratio,
	fit,
	position,
	showCaption = false,
	class: className,
	mediaClass,
} = Astro.props;

// One large derivative for the full viewer (and the no-JS anchor target). Capped to source width by
// astro:assets, so no upscaling. AVIF, not WebP (P9 / D-80): measured across this archive the 1700px WebP
// derivatives average ~125 KB and run to 750 KB, the AVIF ones ~56 KB — the same photograph at the same
// pixel dimensions for roughly a third of the bytes, which is precisely the difference between a viewer
// that opens decisively and one that fills in. Every browser that can run the viewer decodes AVIF, and the
// no-JS anchor target is the same file. Not fetched until the anchor is activated (anchors don't preload),
// so this still adds nothing to initial page weight.
const full = await getImage({ src: image, width: Math.min(image.width, 1700), format: 'avif' });
---

<figure class:list={['pf', className]}>
	<a
		class="pf__open"
		data-photo-protected
		draggable="false"
		href={full.src}
		data-lightbox={group}
		data-lb-full={full.src}
		data-lb-w={image.width}
		data-lb-h={image.height}
		data-lb-alt={alt}
		data-lb-caption={caption ?? ''}
		aria-label={`Bekijk vergroot: ${alt}`}
	>
		<Media
			src={image}
			alt={alt}
			widths={widths}
			sizes={sizes}
			priority={priority}
			ratio={ratio}
			fit={fit}
			position={position}
			class={mediaClass}
		/>
	</a>
	{showCaption && caption && <figcaption class="t-caption pf__caption">{caption}</figcaption>}
</figure>

<style>
	.pf {
		margin: 0;
		min-width: 0;
	}
	.pf__open {
		position: relative;
		display: block;
		cursor: zoom-in;
		outline-offset: 3px;
		transition: transform var(--dur-interaction) var(--ease-standard);
	}
	/*
	 * THE HOVER WHISPER (Experience Architecture §9.3, §12).
	 *
	 * The one pointer-only behaviour in the design: a whisper of the SAME forward step the near plane
	 * performs in full. It exists to preview the mechanism before it is used — teaching the whole
	 * interaction without a tooltip, a hint, or an onboarding overlay — and to confirm that a photograph is
	 * interactive. It is CONFIRMATION, NEVER INFORMATION: it reveals no caption, no title, no category and
	 * no control. If information appeared on hover, touch and keyboard visitors would be reading a poorer
	 * page (§9.2, CLAUDE.md §12.1).
	 *
	 * The photograph steps forward in Z only — head-on, plane parallel to the screen, uniform scale, no
	 * rotation or tilt ever (§2.1). It raises above its neighbours as it comes, which is what makes it read
	 * as a step toward the viewer rather than a size change.
	 */
	@media (hover: hover) and (pointer: fine) {
		.pf__open:hover,
		.pf__open:focus-visible {
			transform: scale(1.012);
			z-index: 2;
		}
	}
	/* Keyboard parity: focus receives the same step, on every input type. */
	.pf__open:focus-visible {
		transform: scale(1.012);
		z-index: 2;
	}
	/* …except the focus the near plane hands BACK to a pointer visitor on close (P12 / D-84): they did not
	   navigate here, so the photograph must simply be where they left it, at rest. See quiet-focus.js. */
	.pf__open[data-focus-quiet]:focus-visible {
		transform: none;
	}
	.pf__caption {
		margin-top: var(--space-sm);
	}
	@media (prefers-reduced-motion: reduce) {
		.pf__open {
			transition: none;
		}
		.pf__open:hover,
		.pf__open:focus-visible {
			transform: none;
		}
	}
</style>
