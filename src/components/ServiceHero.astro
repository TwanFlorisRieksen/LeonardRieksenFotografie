---
/*
 * ServiceHero — full-bleed scrim hero for the two service-detail pages (D-19). Same proven pattern as the
 * project-detail hero (a full-bleed cover + corner scrim + eyebrow/title panel), extracted here because it
 * recurs identically on both service pages — only the photograph, labels and focal position differ. This
 * is the page's LCP candidate: the image is priority-loaded. Not the homepage hero (that is bespoke and
 * sits under the transparent header); these sit below the solid header, like the project hero.
 */
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	eyebrow: string;
	title: string;
	sub?: string;
	/** object-position for the cover crop (composition-aware, no universal crop). */
	position?: string;
	/** Optional contextual parent route (P4 correction #3 — restrained "back to overview", not a breadcrumb). */
	parentHref?: string;
	parentLabel?: string;
}
const { image, alt, eyebrow, title, sub, position = 'center', parentHref, parentLabel } = Astro.props;
---

<header class="svc-hero" style={`--svc-hero-pos:${position}`}>
	<Media
		src={image}
		alt={alt}
		priority={true}
		widths={[480, 800, 1200, 1700]}
		sizes="100vw"
		class="svc-hero__media"
	/>
	<div class="svc-hero__scrim"></div>
	<div class="svc-hero__content u-container u-container--wide">
		{
			parentHref && parentLabel && (
				<a class="svc-hero__parent" href={parentHref}>
					<svg
						width="17"
						height="17"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						focusable="false"
					>
						<path d="M20 12H5M11 6l-6 6 6 6" />
					</svg>
					{parentLabel}
				</a>
			)
		}
		<p class="t-eyebrow t-eyebrow--accent">{eyebrow}</p>
		<h1 class="t-display svc-hero__title">{title}</h1>
		{sub && <p class="t-lead svc-hero__sub">{sub}</p>}
	</div>
</header>

<style>
	.svc-hero {
		position: relative;
		min-height: min(72vh, 680px);
		display: flex;
		align-items: flex-end;
		padding-block: var(--space-3xl);
		overflow: clip;
		isolation: isolate;
	}
	.svc-hero__media {
		position: absolute;
		inset: 0;
		z-index: -1;
	}
	.svc-hero__media :global(picture),
	.svc-hero__media :global(img) {
		width: 100%;
		height: 100%;
	}
	.svc-hero__media :global(img) {
		object-fit: cover;
		object-position: var(--svc-hero-pos);
	}
	.svc-hero__scrim {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--color-image-scrim-corner);
	}
	/* Contextual parent route — restrained, subordinate to the title, in the existing premium link language
	   (arrow nudges, gold on hover). Off-white on the corner scrim is AA. Padding gives a ≥44px touch target
	   without visually enlarging the row (the negative top margin keeps the eyebrow spacing tight). */
	.svc-hero__parent {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		width: fit-content;
		margin-top: calc(-1 * var(--space-sm));
		margin-bottom: var(--space-2xs);
		padding-block: var(--space-sm);
		font-size: var(--fs-body-sm);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.01em;
		color: var(--color-text);
	}
	.svc-hero__parent svg {
		transition: transform var(--dur-interaction) var(--ease-out);
	}
	.svc-hero__parent:hover,
	.svc-hero__parent:focus-visible {
		color: var(--color-accent);
	}
	.svc-hero__parent:hover svg,
	.svc-hero__parent:focus-visible svg {
		transform: translateX(-3px);
	}
	.svc-hero__title {
		margin-top: var(--space-sm);
		max-width: 16ch;
	}
	.svc-hero__sub {
		margin-top: var(--space-lg);
		max-width: 44ch;
		color: var(--color-text);
	}
	@media (max-width: 40rem) {
		.svc-hero {
			min-height: min(62vh, 520px);
		}
	}
</style>
