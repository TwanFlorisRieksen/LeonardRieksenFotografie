---
/*
 * Media — the central image component (ARCH-06 / blueprint 13.132–13.135, 8.83, PH-03/04/05/06).
 * Wraps astro:assets <Picture> so every image on the site gets, consistently:
 *   - responsive AVIF/WebP + fallback derivatives (never the source master — PH-08; the build also
 *     purges any unreferenced original, see scripts/postbuild-verify-assets.mjs)
 *   - reserved intrinsic width/height → CLS protection (PH-04)
 *   - priority control: `priority` = eager + high fetchpriority (LCP hero, PH-05); default = lazy (PH-06)
 *   - ratio-FLEXIBLE by default (image shown whole, fit-over-fill — no universal crop, 2.14/8.14).
 *     A `ratio` may be opted into for grid tiles; even then `fit` defaults to cover but is overridable.
 *   - alt required; pass alt="" for a genuinely decorative image (PH-14).
 * Extra classes/attributes pass through to the wrapper, so callers extend without duplicating markup.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	widths?: number[];
	sizes?: string;
	priority?: boolean;
	formats?: ('avif' | 'webp' | 'png' | 'jpeg')[];
	ratio?: string; /* e.g. "3/2", "16/9" — opt-in framing for grids; omit for intrinsic ratio */
	fit?: 'cover' | 'contain';
	position?: string; /* object-position when framed, default "center" */
	/** Encoder quality. Omit for the project default; raise only for a photograph that is presented
	 *  full-bleed and therefore has to survive being enlarged past its own resolution. */
	quality?: number;
	class?: string;
	[key: string]: unknown;
}

const {
	src,
	alt,
	widths = [400, 800, 1200, 1700],
	sizes = '100vw',
	priority = false,
	formats = ['avif', 'webp'],
	ratio,
	fit = 'cover',
	position = 'center',
	quality,
	class: className,
	...rest
} = Astro.props;

/*
 * AN OVER-SIZED REQUEST IS CLAMPED TO THE MASTER, NEVER DROPPED (P14).
 *
 * THE DEFECT. This line was `widths.filter((w) => w <= src.width)`. Its intent — never upscale (R-04) — is
 * right; its arithmetic threw away the master's own resolution whenever a caller asked for a width above it.
 * The largest candidate then fell back to the next value DOWN in the list, which is wherever the author
 * happened to put it. Measured on the built site:
 *
 *     homepage hero   master 1536 · asked [640, 1024, 1400, 1920] → 1920 dropped → largest candidate 1400
 *     service hero    master 1536 · asked [480, 800, 1200, 1700]  → 1700 dropped → largest candidate 1200
 *
 * Both are full-bleed `sizes="100vw"` photographs. So on a 1440 CSS-px desktop at DPR 1 the hero was already
 * being enlarged before retina entered the argument, and the service hero was being enlarged 1.2× at DPR 1
 * and 2.4× at DPR 2 — with 336 px of real, paid-for detail sitting unused in the master. This is the whole
 * of the "de hero ziet er op grote schermen laagresolutie uit" report that is actually fixable in code.
 *
 * THE RULE. Clamp to `src.width` and de-duplicate. No derivative is ever larger than the source, so R-04 and
 * PH-08 are untouched, and the top of every srcset is now exactly as sharp as the photograph Leo delivered.
 *
 * WHAT THIS CANNOT FIX, and must not be reported as fixed: the masters themselves. `hero.jpeg` is 1536×1024
 * and every archive master is 1700 px wide. At 1440 CSS px / DPR 2 the browser wants 2880 px and the file
 * simply does not contain them. See documenten/ASSET_INVENTORY.md — a larger hero master is an owner input,
 * not an implementation choice, and nothing here upscales to fake it.
 */
const requested = widths.map((w) => Math.min(w, src.width));
const effectiveWidths = [...new Set(requested)].sort((a, b) => a - b);

const styleVars = ratio ? `--media-ratio:${ratio};--media-fit:${fit};--media-pos:${position};` : undefined;
---

<div
	class:list={['media', 'media--protected', { 'media--framed': !!ratio }, className]}
	data-photo-protected
	style={styleVars}
	{...rest}
>
	<Picture
		src={src}
		alt={alt}
		widths={effectiveWidths}
		sizes={sizes}
		formats={formats}
		loading={priority ? 'eager' : 'lazy'}
		decoding={priority ? 'auto' : 'async'}
		fetchpriority={priority ? 'high' : 'auto'}
		{...(quality ? { quality } : {})}
	/>
</div>

<style>
	.media {
		display: block;
		overflow: clip;
		/* Grid/flex items default to min-width:auto, which browsers resolve against the *intrinsic* image
		   size — this blows a grid track open (e.g. a 3-col grid rendering at ~2x its container) instead of
		   letting the image shrink to its track/flex-basis. min-width/min-height:0 restores normal shrinking. */
		min-width: 0;
		min-height: 0;
		background: var(--color-surface); /* calm holding colour before decode (no flashing skeleton, PH-07) */
	}
	/* Discourage the common save gestures without changing native scrolling, keyboard access, or the
	   lightbox. This is a deterrent for the rendered photograph surface, not a claim that screenshots or
	   determined extraction are impossible. */
	.media--protected,
	.media--protected :global(picture),
	.media--protected :global(img) {
		user-select: none;
		-webkit-user-select: none;
		-webkit-user-drag: none;
		-webkit-touch-callout: none;
	}
	.media :global(img) {
		width: 100%;
		height: auto;
	}
	/* Opt-in framed mode for grid tiles: fixed ratio box, image fits inside it.
	   `picture`/`img` are positioned absolutely against this box rather than sized with height:100% — a
	   box whose height comes only from `aspect-ratio` (not an explicit height) does not reliably give
	   percentage-height descendants a definite height to resolve against, so `height:100%` on the img
	   silently fell back to its intrinsic auto height: shorter images under-filled the frame (exposing
	   the holding-colour background as a bar) and taller images silently overflowed past it (clipped by
	   `overflow:clip` above, with object-position never actually engaging). Absolute positioning gives the
	   picture/img a definite containing block regardless of how the parent's height was derived. */
	.media--framed {
		position: relative;
		aspect-ratio: var(--media-ratio);
	}
	.media--framed :global(picture) {
		position: absolute;
		inset: 0;
	}
	.media--framed :global(img) {
		width: 100%;
		height: 100%;
		object-fit: var(--media-fit);
		object-position: var(--media-pos);
	}
</style>
