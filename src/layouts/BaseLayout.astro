---
import { pageTitle, canonicalURL, SITE_NAME } from '../lib/seo';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
	/** Page-specific title (without the site-name suffix — pageTitle() adds it). Required per page (SEO-04). */
	title: string;
	/** Page-specific meta description. Required per page (SEO-04) — no shared fallback across pages. */
	description: string;
	/** Absolute URL to a social preview image; falls back to no og:image tag when omitted (no invented default). */
	socialImage?: string;
	/** Suppress indexing (dev-only pages such as the styleguide). */
	noindex?: boolean;
	/** Optional extra class on <body> (e.g. the styleguide surface). */
	bodyClass?: string;
}

const { title, description, socialImage, noindex = false, bodyClass } = Astro.props;
const canonical = canonicalURL(Astro.site, Astro.url);
// OG spec requires an absolute image URL; page authors may pass either a relative build path or
// an already-absolute URL, so resolve defensively rather than assuming.
const absoluteSocialImage = socialImage
	? new URL(socialImage, Astro.site ?? Astro.url).toString()
	: undefined;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0f131a" />
		<title>{pageTitle(title)}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Preload the two critical font faces (display-400 + sans-400) to cut first-paint swap (PERF-07). -->
		<link
			rel="preload"
			href="/fonts/instrument-serif-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/instrument-sans-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle(title)} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{absoluteSocialImage && <meta property="og:image" content={absoluteSocialImage} />}

		<meta name="generator" content={Astro.generator} />
	</head>
	<body class:list={[bodyClass]}>
		<a class="skip-link" href="#main-content">Direct naar inhoud</a>
		<SiteHeader />
		<main id="main-content">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
