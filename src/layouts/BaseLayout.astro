---
import { pageTitle, canonicalURL, SITE_NAME } from '../lib/seo';

interface Props {
	/** Page-specific title (without the site-name suffix — pageTitle() adds it). Required per page (SEO-04). */
	title: string;
	/** Page-specific meta description. Required per page (SEO-04) — no shared fallback across pages. */
	description: string;
	/** Absolute URL to a social preview image; falls back to no og:image tag when omitted (no invented default). */
	socialImage?: string;
}

const { title, description, socialImage } = Astro.props;
const canonical = canonicalURL(Astro.site, Astro.url);
// OG spec requires an absolute image URL; page authors may pass either a relative build path or
// an already-absolute URL, so resolve defensively rather than assuming.
const absoluteSocialImage = socialImage
	? new URL(socialImage, Astro.site ?? Astro.url).toString()
	: undefined;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle(title)}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={pageTitle(title)} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{absoluteSocialImage && <meta property="og:image" content={absoluteSocialImage} />}

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Direct naar inhoud</a>
		<header>
			<slot name="header">
				<p>
					<a href="/">{SITE_NAME}</a>
				</p>
				<nav aria-label="Hoofdnavigatie">
					<ul>
						<li><a href="/portfolio/">Portfolio</a></li>
						<li><a href="/diensten/">Diensten</a></li>
						<li><a href="/over-mij/">Over mij</a></li>
						<li><a href="/contact/">Contact</a></li>
					</ul>
				</nav>
			</slot>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer>
			<slot name="footer">
				<p>&copy; {new Date().getFullYear()} {SITE_NAME}</p>
				<nav aria-label="Footernavigatie">
					<ul>
						<li><a href="/privacy/">Privacyverklaring</a></li>
					</ul>
				</nav>
			</slot>
		</footer>
	</body>
</html>

<style>
	/*
	 * Technical scaffold only — no design-system styling belongs here (P2). This exists solely so the
	 * skip link is not permanently invisible/unusable during P1 route validation.
	 */
	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
	}
	.skip-link:focus {
		left: 0;
		z-index: 1000;
	}
</style>
