		// stood between arriving and travelling. The arrival is now a one-shot CSS emergence on the field
		// (traverse.css `tv-emerge`), which cannot gate anything because nothing waits on it.
		(window as unknown as Record<string, unknown>).__tv = mountTraverse(root, {
