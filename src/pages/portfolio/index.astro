---
/*
 * PORTFOLIO, DE DOORTOCHT (the spatial traverse), travelled as THREE WORLDS (Phase 3, D-73).
 *
 * The Interaction Engine (the coil, camera, physics, reading moment, D-65→D-72) is the FROZEN foundation
 * and is untouched here. Phase 3 is INTEGRATION: it gives the traverse the structure, categories, brand
 * identity and wayfinding of a finished portfolio, entirely in a chrome layer OVER the coil and in the
 * accessible document BENEATH it, never as objects inside the world (the coil's one rule: photographs and
 * nothing else). See documenten/DECISIONS.md D-73.
 *
 * THREE WORLDS. getContinuum() now returns the works in THREE CONTIGUOUS worlds, Projecten, Architectuur,
 * Interieur, plus their boundaries. Each world is one unbroken stretch of the coil, so the visitor enters
 * it; the boundary is a gradient (the wayfinding text changes and the ambient tint eases cool→warm), never
 * a cut (Experience Architecture §4.1/§4.2). Categories are STRUCTURAL, not a filter widget (§5.1, 13.27/28).
 *
 * THE PROGRESSIVE-ENHANCEMENT TRUTH is the document below, deliberately complete on its own: three real
 * <section> chapters, each with a heading + count, every work server-rendered in curatorial order with real
 * alt text and a real optimised derivative. Series carry a real href to their project page; loose works
 * carry a real lightbox anchor that, without JavaScript, simply opens the optimised derivative (blueprint
 * 8.22 / §16.3). Without JS or under reduced motion the three headed chapters ARE the wayfinding; the chrome
 * overlay (marker, world-title beats, scroll hint, ambient tint) only appears once the coil is active.
 *
 * THE LIGHTBOX is supplementary (§4.4): the scrollable coil is the primary portfolio. It intercepts the
 * loose-work anchors; series works navigate to their richer project pages.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Media from '../../components/Media.astro';
import Lightbox from '../../components/Lightbox.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getContinuum } from '../../lib/portfolio';
import '../../styles/traverse.css';
import '../../styles/portfolio-chrome.css';

const { items, worlds } = await getContinuum();

/* Per-world slices for the baseline chapters. The flat `items` order is unchanged (series → architectuur →
   interieur), so the runtime's work indices line up exactly with each world's `start` boundary. */
const worldSlices = worlds.map((w) => ({ world: w, works: items.slice(w.start, w.start + w.count) }));

/*
 * LIGHTBOX DERIVATIVES for the loose works. One large AVIF derivative per loose work (WebP until P9/D-80
 * see PhotoFrame.astro for the measurement; ~56 KB against ~125 KB for the same 1700px photograph), the same optimised
 * derivative PhotoFrame uses (capped to the source width by astro:assets, so no upscaling, PH-08). Series
 * works navigate to their project page instead and get no lightbox anchor. Anchors do not preload, so these
 * add nothing to initial page weight; they are fetched only when a visitor opens the near plane.
 */
const fulls = new Map<(typeof items)[number], string>();
for (const it of items) {
	if (!it.href) {
		const f = await getImage({ src: it.image, width: Math.min(it.image.width, 1700), format: 'avif' });
		fulls.set(it, f.src);
	}
}

/* LEAD-INS, a handful of works sampled from LATER in the sequence, cloned ABOVE the crown so the coil
   reads as an object that already exists rather than one that begins from nothing (owner, Phase 2.3).
   They are decorative: aria-hidden, unfocusable, no caption, no link, and hidden entirely without JS
   (see .tv-lead in traverse.css). The runtime places them at negative ribbon angle; they never touch the
   journey, keyboard order, the geometry report or any world boundary. */
const N = items.length;
const leadItems = [0.44, 0.52, 0.6, 0.68, 0.76, 0.84, 0.9]
	.map((f) => items[Math.round((N - 1) * f)])
	.filter(Boolean);

/* THIS `sizes` DESCRIBES THE NO-JS DOCUMENT, NOT THE COIL. The server-rendered page is a single column of
   whole photographs at `min(100%, 62rem)` (see traverse.css). The runtime rewrites `sizes` from the actual
   coil geometry the moment it measures (see traverse.js), so both layouts get a truthful hint. */
const SIZES = '(max-width: 68rem) 92vw, 62rem';
---

<BaseLayout
	title="Portfolio"
	description="Het portfolio van Leonard Rieksen Fotografie, architectuur- en interieurfotografie, van complete reeksen tot losse beelden, als één doorlopende doortocht door het werk in drie werelden: Projecten, Architectuur en Interieur."
	bodyClass="is-portfolio"
>
	<div class="tv" data-tv-root>
		<!-- THE OVERTURE (Phase 4, D-74). The premium entrance: a full-bleed brand curtain that holds while
		     the crown imagery decodes, then dissolves as the coil resolves into focus beneath it. Shown ONLY
		     with JS enabled (html.js) and NOT under reduced motion, so no-JS never sees a stuck curtain and
		     reduced motion goes straight to the accessible document. Decorative (aria-hidden, unfocusable):
		     the real H1 + three chapters live beneath it. Loading is felt, not bureaucratic, the hairline of
		     light draws to full as the world becomes ready; there is no spinner, bar or percentage. -->
		<div class="pf-overture" data-pf-overture aria-hidden="true">
			<div class="pf-overture__inner">
				<p class="pf-overture__brand">Leonard&nbsp;Rieksen</p>
				<p class="pf-overture__eyebrow">Fotografie</p>
				<p class="pf-overture__work">Portfolio</p>
				<span class="pf-overture__line">
					<span class="pf-overture__line-fill" data-pf-load-fill></span>
				</span>
			</div>
		</div>

		<!-- The scroll spacer: real page height, real scrollbar, real native paging. The runtime sets its
		     height from the number of works, so the scrollbar is honest about how much work remains. -->
		<div class="tv-scroll" data-tv-scroll aria-hidden="true"></div>

		<!-- THE OVERTURE VEIL (P8.7 / D-78). The owner on the opening: "het is heel druk, heel veel
		     verschillende dingen, je raakt er bijna van in paniek, op mobiel is het al helemaal een drama."
		     The cause is arrival order: the D-74 entrance resolves the coil FULLY and then puts the brand
		     overture on top of it, so the first thing the visitor meets is a finished 3D world of ~14
		     photographs AND a title AND a lede AND a wayfinding marker, all at once and all at full strength.
		     Nothing there is wrong on its own; there is simply no first beat.
		     This is that beat: a calm field over the coil while the overture is being read, so the world is
		     PRESENT but not yet the subject, you can see there is something there, and you are not asked to
		     look at it yet. It lifts on the same signal the overture leaves on (the first real travel), which
		     means it costs the reader nothing: one scroll and the world is theirs. Purely presentational and
		     `aria-hidden`; it never gates content, and under reduced motion / no-JS the coil is not mounted at
		     all, so it never appears. -->
		<div class="pf-veil" data-pf-veil aria-hidden="true"></div>

		<!-- THE OPENING (§3.1). In the baseline document this is the page heading + a quiet lead. Under the
		     active coil it becomes the opening overlay at the crown and fades as the visitor descends, the
		     "shape of the collection", stated once, quietly. The h1 stays for SEO/screen readers either way. -->
		<header class="pf-intro" data-pf-intro>
			<p class="pf-intro__eyebrow">Leonard Rieksen Fotografie</p>
			<h1 class="pf-intro__title">Portfolio</h1>
			<p class="pf-intro__lead">
				Een doorlopende reis door het werk van Leo Rieksen, architectuur en interieur, van complete
				reeksen tot losse beelden.
			</p>
		</header>

		<div class="tv-viewport">
			<!-- THE WORLD BEHIND THE COIL (Fase 5, D-75). A modelled blue-hour space, a stack of pre-painted
			     gradient layers whose OPACITY the chrome controller cross-fades along the journey (blue hour →
			     deep nocturne → warm interior), plus a slow, light-only breath. It lives BEHIND the ribbon (the
			     works are opaque and painted on top) and shows only in the negative space, so it can never fall
			     on a photograph (§6.16, the coil's one rule). Decorative and absent from the accessible document:
			     aria-hidden, and display:none until [data-tv-active] (see portfolio-chrome.css §2). -->
			<div class="tv-sky" aria-hidden="true">
				<div class="tv-sky__base"></div>
				<div class="tv-sky__cool"></div>
				<div class="tv-sky__warm"></div>
				<div class="tv-sky__breath"></div>
				<div class="tv-sky__haze"></div>
				<div class="tv-sky__vignette"></div>
			</div>
			<div class="tv-field" data-tv-stage>
				{
					worldSlices.map(({ world, works }) => (
						<section class="tv-world" data-tv-world={world.id} aria-labelledby={`world-${world.id}`}>
							{/* Wall text, not a room (§4.2): a quiet typographic chapter opening in the baseline;
							    hidden under the active coil, where the chrome names the world instead. */}
							<header class="tv-world__intro">
								<h2 class="tv-world__title" id={`world-${world.id}`}>
									{world.label}
								</h2>
								<p class="tv-world__meta">
									<span class="tv-world__count">{world.count}</span>
									<span class="tv-world__sub">{world.sub}</span>
								</p>
							</header>
							{works.map((it) => {
								const gi = world.start + works.indexOf(it); // global index → LCP priority for the crown
								const ar = it.ar || 1.5;
								const full = fulls.get(it);
								const isSeries = Boolean(it.href);
								const media = (
									<Media
										src={it.image}
										alt={it.alt}
										sizes={SIZES}
										widths={[600, 900, 1300, 1700]}
										priority={gi < 3}
									/>
								);
								/* PROJECT RECOGNITION (Phase 4, D-74). A SERIES announces itself as enterable, its
								   title, then a gold hairline that draws in with the caption, then a "reeks"
								   affordance with an arrow. This is visual hierarchy in the photograph's OWN caption
								   (title + count), never a button, card or label bolted on: a project arriving at its
								   reading moment simply reads as "here a body of work begins", where a loose work reads
								   as one quiet line. A LOOSE work carries a real lightbox anchor (openable without JS);
								   a SERIES carries a real <a> to its richer project page. */
								const caption = isSeries ? (
									<figcaption class="tv-cap tv-cap--series">
										<span class="tv-cap__title">{it.caption ?? it.label}</span>
										<span class="tv-cap__rule" aria-hidden="true"></span>
										<span class="tv-cap__more">
											{it.label}
											<span class="tv-cap__arrow" aria-hidden="true">&#8594;</span>
										</span>
									</figcaption>
								) : (
									<figcaption class="tv-cap">{it.caption ?? it.label}</figcaption>
								);
								const inner = (
									<>
										{media}
										{caption}
									</>
								);
								/* Every work is a tab stop. Focusing a work travels the camera to it, so keyboard and
								   scroll traversal are one journey. */
								return (
									<figure
										class="tv-work"
										id={`work-${it.id}`}
										data-tv-work
										data-world={world.id}
										data-kind={isSeries ? 'series' : 'work'}
										data-ar={ar.toFixed(4)}
									>
										{isSeries ? (
											<a href={it.href} class="tv-work__link">
												{inner}
											</a>
										) : (
											<a
												href={full}
												class="tv-work__link"
												data-lightbox={`pf-${world.id}`}
												data-lb-full={full}
												data-lb-w={it.image.width}
												data-lb-h={it.image.height}
												data-lb-alt={it.alt}
												data-lb-caption={it.caption ?? it.label}
												aria-label={`Bekijk vergroot: ${it.alt}`}
											>
												{inner}
											</a>
										)}
									</figure>
								);
							})}
						</section>
					))
				}
				{
					/* Decorative top-fill; positioned by the runtime at negative ribbon angle, never present
					   without JavaScript, never part of any world. */
					leadItems.map((it, li) => {
						const ar = it.ar || 1.5;
						/* P12 (D-84): the first three lead-ins are CROWN imagery — they are what fills the top of
						   the frame at journey 0 — so they carry the same fetch priority as the first works. They
						   were `priority={false}`, i.e. the last things the browser asked for, which is why the
						   entrance curtain (which now waits on them) lifted on a coil whose upper half was blank.
						   The rest stay lazy: they are only reached once the visitor is already travelling. */
						return (
							<figure class="tv-work tv-lead" data-tv-lead data-ar={ar.toFixed(4)} aria-hidden="true">
								<Media src={it.image} alt="" sizes={SIZES} widths={[600, 900]} priority={li < 3} />
							</figure>
						);
					})
				}
			</div>
		</div>

		<!-- ============================================================================================= *
		     P9 (D-80), IMAGE-DELIVERY DISCIPLINE FOR THE COIL.

		     THE DEFECT. Every panel in the coil is absolutely positioned inside one fixed stage, so its LAYOUT
		     box sits inside the viewport whatever the camera is doing. Native `loading="lazy"` therefore judged
		     the entire archive to be in view and fetched it at once, measured on the built site: 47 of the 62
		     photographs and 3.0 MB on a 1440×900 desktop, 56 and 3.2 MB on a 390pt phone, at scroll position 0,
		     while the engine was drawing 12–14 of them. And it fetched them at the WRONG SIZE: <Media> renders a
		     <Picture>, so the browser selects from the first matching <source>, and that <source> carried the
		     server-rendered `sizes`, which describes the no-JS single column (92vw / 62rem), not the coil, where
		     a photograph presents at roughly a third of that. A 339px panel was served the 1700w derivative.

		     THE FIX, in one move. This script, deliberately `is:inline` and in parser position, because a module
		     script is far too late, stashes every coil `srcset` in `data-tv-srcset`. Nothing in the coil is then
		     fetched from the markup at all. traverse.js measures, writes each work's TRUE presented width to its
		     <source> elements, and restores the srcset for the works near the camera (CFG.loadAhead), so every
		     photograph is requested at the right size and only when it is genuinely approaching. The overture
		     waits on that restored crown instead of on the markup (portfolio-intro.js), so the entrance is
		     unchanged: the curtain still holds until the crown's photography is decoded.

		     GUARDS. Runs only when JavaScript is live AND motion is welcome, exactly when the coil will mount.
		     Without JS nothing here executes; under reduced motion it returns before stashing. In both of those
		     the accessible chaptered column keeps every photograph at the size its own `sizes` describes, which
		     is why that server-rendered hint stays exactly as it was. A load-time failsafe restores anything
		     still stashed if the coil never activates, so no runtime failure can cost a photograph. -->
		<script is:inline>
			(function () {
				var root = document.querySelector('[data-tv-root]');
				if (!root || !document.documentElement.classList.contains('js')) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				var els = root.querySelectorAll(
					'[data-tv-work] source[srcset], [data-tv-work] img[srcset], [data-tv-lead] source[srcset], [data-tv-lead] img[srcset]'
				);
				for (var i = 0; i < els.length; i++) {
					var el = els[i];
					el.setAttribute('data-tv-srcset', el.getAttribute('srcset'));
					el.removeAttribute('srcset');
					if (el.tagName === 'IMG') {
						var src = el.getAttribute('src');
						if (src) {
							el.setAttribute('data-tv-src', src);
							el.removeAttribute('src');
						}
					}
				}

				/* FAILSAFE. If the coil never activates, a runtime error, an environment that refuses the 3D
				   field, no photograph may stay stashed. One pass shortly after load restores everything the
				   engine has not already claimed, so the worst case is the previous behaviour, never a gap. */
				window.setTimeout(function () {
					if (root.hasAttribute('data-tv-active')) return;
					var stuck = root.querySelectorAll('[data-tv-srcset]');
					for (var n = 0; n < stuck.length; n++) {
						var e = stuck[n];
						e.setAttribute('srcset', e.getAttribute('data-tv-srcset'));
						if (e.hasAttribute('data-tv-src')) {
							e.setAttribute('src', e.getAttribute('data-tv-src'));
							e.removeAttribute('data-tv-src');
						}
						e.removeAttribute('data-tv-srcset');
					}
				}, 6000);
			})();
		</script>

		<!-- ===================== INTEGRATION CHROME (active coil only) ===================== -->
		<!-- All of this is hidden until [data-tv-active] (see portfolio-chrome.css): under no-JS and reduced
		     motion the three headed chapters above are the wayfinding, and none of this exists. -->

		<!-- PERSISTENT WAYFINDING MARKER (§7.2/§7.4): names the current world + position, expandable into a
		     jump list that reaches any world from anywhere. Static text; only its wording changes. The jump
		     items are real #work-<id> anchors, so they work natively when the chrome script is not driving. -->
		<nav class="pf-wayfind" data-pf-wayfind aria-label="Waar je bent in het portfolio">
			<button
				type="button"
				class="pf-wayfind__toggle"
				data-pf-toggle
				aria-expanded="false"
				aria-controls="pf-worlds"
			>
				<span class="pf-wayfind__eyebrow">Portfolio</span>
				<span class="pf-wayfind__now">
					<span class="pf-wayfind__name" data-pf-now>{worlds[0]?.label}</span>
					<span class="pf-wayfind__pos" data-pf-pos>1&#8202;/&#8202;{worlds.length}</span>
				</span>
				<!-- OVERALL PROGRESS (Phase 4, D-74): a hairline that fills as the visitor descends the whole
				     coil, a constant, quiet sense of how far the journey has come, without a scrollbar. -->
				<span class="pf-wayfind__track" aria-hidden="true">
					<span class="pf-wayfind__track-fill" data-pf-progress-fill></span>
				</span>
			</button>
			<div class="pf-wayfind__panel" id="pf-worlds" data-pf-list hidden>
				<p class="pf-wayfind__heading">De reis</p>
				<!-- THE MAP (Phase 4, D-74): the whole coil as three proportional world segments (sized by their
				     work counts) with a live position node. Click anywhere to travel there instantly, the fast
				     way across a long collection, and the far-left is the way back to the beginning. Decorative
				     (aria-hidden): the labelled list below is the exact, keyboard-accessible equivalent. -->
				<div class="pf-map" data-pf-map aria-hidden="true">
					<div class="pf-map__track">
						{
							worlds.map((w) => (
								<span class="pf-map__seg" data-pf-seg={w.id} style={`flex-grow:${w.count}`} />
							))
						}
					</div>
					<span class="pf-map__node" data-pf-node></span>
				</div>
				<ul class="pf-wayfind__list">
					{
						worlds.map((w, i) => (
							<li>
								<a
									class="pf-jump"
									href={`#${w.anchorId}`}
									data-pf-jump={w.id}
									data-pf-index={w.start}
									aria-current={i === 0 ? 'true' : undefined}
								>
									<span class="pf-jump__label">{w.label}</span>
									<span class="pf-jump__count">{w.count}</span>
									<span class="pf-jump__sub">{w.sub}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>

		<!-- WORLD-TITLE BEAT: eases in briefly when the visitor enters a world, then fades, "je komt een
		     nieuwe wereld binnen", typographic. aria-hidden: the wayfinding nav and headings carry it for AT. -->
		<div class="pf-beat" data-pf-beat aria-hidden="true">
			<span class="pf-beat__name" data-pf-beat-name></span>
			<!-- A gold hairline that draws as you cross into a new world (Fase 5, D-75), the site's seam-gold
			     detail language marking each transition, never a fill or a heading. -->
			<span class="pf-beat__seam"></span>
			<span class="pf-beat__sub" data-pf-beat-sub></span>
		</div>

		<!-- THE SCROLL HINT IS GONE (P8.7 / D-78). It existed because "the coil fills upward, so which way is
		     not obvious", but the coil now DESCENDS BY ITSELF when the reader is idle (the D-72 auto-drift),
		     so the world states the direction by moving in it. A label telling you to do what the page is
		     already visibly doing is one more thing on the busiest screen of the site, and the owner's note
		     ("de aanwijzing om te scrollen kan in ieder geval weg, want hij begint nu automatisch met
		     scrollen") is exactly right. Removed, not hidden: the markup, the CSS and its listeners are all
		     deleted. -->

		<!-- The world boundaries, for the chrome controller. Structural data only (a JSON data island). -->
		<script type="application/json" data-tv-worlds is:inline set:html={JSON.stringify(worlds)}></script>
	</div>

	<!-- After the journey: the contact invitation, then the site footer flow in below the fixed coil once the
	     outro has dissolved it (owner: "de footer hoort NA de reis"). Present without JavaScript too. -->
	<ContactCta
		heading="Een gebouw dat gefotografeerd wil worden?"
		primaryLabel="Neem contact op"
		primaryHref="/contact/"
	/>

	<Lightbox />
</BaseLayout>

<script>
	import { mountTraverse } from '../../scripts/traverse.js';
	import { mountChrome } from '../../scripts/portfolio-chrome.js';
	import { mountIntro } from '../../scripts/portfolio-intro.js';

	const root = document.querySelector('[data-tv-root]');
	if (root) {
		// The chrome reads the world from the SAME journey the coil is drawn from, via the runtime's onFrame
		// seam. Under reduced motion the runtime never mounts, so onFrame never fires and the chrome stays in
		// its static state (the headed chapters do the wayfinding).
		const chrome = mountChrome(root);
		// THE OVERTURE (Phase 4, D-74) gates the engine mount: it holds the brand curtain while the crown
		// imagery decodes, then reveals the coil emerging into focus. Under reduced motion / no-JS it mounts
		// immediately (the curtain is CSS-hidden there), so the accessible document is never blocked.
		mountIntro(root, {
			mount() {
				(window as unknown as Record<string, unknown>).__tv = mountTraverse(root, {
					expose: true,
					onFrame: chrome.onFrame,
				});
			},
		});
	}
</script>
