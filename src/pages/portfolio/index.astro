---
/*
 * PORTFOLIO, DE DOORTOCHT (the spatial traverse), travelled as THREE WORLDS (Phase 3, D-73).
 *
 * The Interaction Engine (the coil, camera, physics, reading moment, D-65→D-72) is the FROZEN foundation
 * and is untouched here. Phase 3 is INTEGRATION: it gives the traverse the structure, categories, brand
 * identity and wayfinding of a finished portfolio, entirely in a chrome layer OVER the coil and in the
 * accessible document BENEATH it, never as objects inside the world (the coil's one rule: photographs and
 * nothing else). See documenten/DECISIONS.md D-73.
 *
 * THREE WORLDS. getContinuum() now returns the works in THREE CONTIGUOUS worlds, Projecten, Architectuur,
 * Interieur, plus their boundaries. Each world is one unbroken stretch of the coil, so the visitor enters
 * it; the boundary is a gradient (the wayfinding text changes and the ambient tint eases cool→warm), never
 * a cut (Experience Architecture §4.1/§4.2). Categories are STRUCTURAL, not a filter widget (§5.1, 13.27/28).
 *
 * THE PROGRESSIVE-ENHANCEMENT TRUTH is the document below, deliberately complete on its own: three real
 * <section> chapters, each with a heading + count, every work server-rendered in curatorial order with real
 * alt text and a real optimised derivative. Series carry a real href to their project page; loose works
 * carry a real lightbox anchor that, without JavaScript, simply opens the optimised derivative (blueprint
 * 8.22 / §16.3). Without JS or under reduced motion the three headed chapters ARE the wayfinding; the chrome
 * overlay (the corner mark, the world mark, the crossing beat, the ambient sky) only appears once the coil
 * is active — with the sole exception of the BOOT state (P15), which is what stands between the visitor and
 * this document during the handover; see the note on `data-tv-boot` below.
 *
 * THE LIGHTBOX is supplementary (§4.4): the scrollable coil is the primary portfolio. It intercepts the
 * loose-work anchors; series works navigate to their richer project pages.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Media from '../../components/Media.astro';
import Lightbox from '../../components/Lightbox.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getContinuum } from '../../lib/portfolio';
import '../../styles/traverse.css';
import '../../styles/portfolio-chrome.css';

const { items, worlds } = await getContinuum();

/* Per-world slices for the baseline chapters. The flat `items` order is unchanged (series → architectuur →
   interieur), so the runtime's work indices line up exactly with each world's `start` boundary. */
const worldSlices = worlds.map((w) => ({ world: w, works: items.slice(w.start, w.start + w.count) }));

/* The whole coil's length in works — the denominator the world rail's boundary ticks are placed against, so
   the hairline map divides exactly where the collection does. Derived from the last world's boundary (the
   same expression the chrome controller uses at runtime) rather than from `items.length`, so the two can
   never disagree. */
const totalWorks = Math.max(
	(worlds[worlds.length - 1]?.start ?? 0) + (worlds[worlds.length - 1]?.count ?? 0),
	1,
);

/*
 * LIGHTBOX DERIVATIVES for the loose works. One large AVIF derivative per loose work (WebP until P9/D-80
 * see PhotoFrame.astro for the measurement; ~56 KB against ~125 KB for the same 1700px photograph), the same optimised
 * derivative PhotoFrame uses (capped to the source width by astro:assets, so no upscaling, PH-08). Series
 * works navigate to their project page instead and get no lightbox anchor. Anchors do not preload, so these
 * add nothing to initial page weight; they are fetched only when a visitor opens the near plane.
 */
const fulls = new Map<(typeof items)[number], string>();
for (const it of items) {
	if (!it.href) {
		const f = await getImage({ src: it.image, width: Math.min(it.image.width, 1700), format: 'avif' });
		fulls.set(it, f.src);
	}
}

/* LEAD-INS, a handful of works sampled from LATER in the sequence, cloned ABOVE the crown so the coil
   reads as an object that already exists rather than one that begins from nothing (owner, Phase 2.3).
   They are decorative: aria-hidden, unfocusable, no caption, no link, and hidden entirely without JS
   (see .tv-lead in traverse.css). The runtime places them at negative ribbon angle; they never touch the
   journey, keyboard order, the geometry report or any world boundary. */
const N = items.length;
const leadItems = [0.44, 0.52, 0.6, 0.68, 0.76, 0.84, 0.9]
	.map((f) => items[Math.round((N - 1) * f)])
	.filter(Boolean);

/* THIS `sizes` DESCRIBES THE NO-JS DOCUMENT, NOT THE COIL. The server-rendered page is a single column of
   whole photographs at `min(100%, 62rem)` (see traverse.css). The runtime rewrites `sizes` from the actual
   coil geometry the moment it measures (see traverse.js), so both layouts get a truthful hint. */
const SIZES = '(max-width: 68rem) 92vw, 62rem';
---

<BaseLayout
	title="Portfolio"
	description="Het portfolio van Leonard Rieksen Fotografie, architectuur- en interieurfotografie, van complete reeksen tot losse beelden, als één doorlopende doortocht door het werk in drie werelden: Projecten, Architectuur en Interieur."
	bodyClass="is-portfolio"
>
	<!-- ================================================================================================= *
	     `data-tv-boot` — THE BOOT STATE (P15). "Dat oude concept bestaat helemaal niet meer."

	     WHAT THE OWNER SEES on entry, and it is not a ghost of an old build: it is the ACCESSIBLE DOCUMENT
	     below — a centred display-size "Portfolio" over a lede, then "Projecten / 9 / Complete opdrachten,
	     als geheel" over a single 62rem column of photographs. That document is the progressive-enhancement
	     truth this page is required to ship (blueprint 8.22 / §16.3), it is correct, and it is also a
	     completely different portfolio design. Until the engine raises `data-tv-active` it is what the
	     browser paints. MEASURED on the built site at 1.6 Mbps / 4x CPU: it held the screen from first paint
	     to ~2.6 s — seconds of a portfolio concept that is not this one, on every cold visit, and long
	     enough on a warm one to register as a flash.

	     WHY IT IS NOT DELETED. Without JavaScript and under reduced motion it IS the whole portfolio, and it
	     is what search engines and screen readers read. Deleting it trades a flash for a broken page.

	     THE FIX IS THE MISSING HANDSHAKE, AND IT IS DECLARATIVE ON PURPOSE. This attribute is in the HTML,
	     so it is true from the very first byte the parser sees — there is no script to wait for and
	     therefore no window in which the wrong layout can paint. (An earlier cut set it from the inline
	     script further down this file; MEASURED, that script is below 140 KB of markup, so on a throttled
	     connection the baseline column had already been on screen for 1.8 s before it ran. Timing was the
	     whole defect; a flag that races the paint cannot fix a flash.) The stylesheet gates its effect on
	     `html.js` — set in BaseLayout's render-blocking head script — and on
	     `prefers-reduced-motion: no-preference`, which are exactly the two conditions the engine mounts
	     under. See portfolio-chrome.css §0.

	     FAILSAFE. If the engine never activates — a runtime error, a browser that refuses the 3D field — the
	     same delayed pass that restores the stashed photography below drops this attribute, and the
	     accessible column is exactly what it always was. The worst case is the previous behaviour arriving
	     late, never a page that stays empty. Nothing here gates, waits or has to be dismissed: the boot
	     state ends on `data-tv-active`, which on a warm load is the next frame. -->
	<div class="tv" data-tv-root data-tv-boot>
		<!-- THE ENTRANCE IS NOT A CURTAIN ANY MORE (P14).
		     WHAT WAS HERE. A full-bleed brand OVERTURE (D-74) held over the whole viewport while the crown
		     photography decoded — up to a 4.2 s hard cap — with a hairline of light drawing to full, and only
		     then dissolved as the coil emerged. It was built to solve a real problem (before it, the visitor
		     watched empty dark rectangles fill in one at a time) and it solved that problem. But the owner's
		     verdict on the result is the one that decides: entering the portfolio should feel like "ik ben in
		     het portfolio", not "ik moet eerst door een intro heen". A brand panel between the visitor and the
		     work is a wait, however beautifully it is drawn, and it is a wait on the one page whose entire
		     purpose is the work.
		     WHAT REPLACES IT. Nothing that gates. The engine mounts on the first frame and the coil is live,
		     scrollable and touchable immediately; the arrival is a one-shot CSS emergence on the field itself
		     (`tv-emerge`, traverse.css) that resolves the world out of a soft blur into focus while the visitor
		     is already free to move it. Nothing waits on a decode, nothing covers the page, and there is no
		     state to get stuck in — the animation cannot fail to end because nothing is listening for it.
		     The original problem is still answered, and better: since D-80 the ENGINE decides what to fetch
		     (the works near the camera, at the size it will present them) and the crown is `priority`, so what
		     the emergence resolves into is the crown, not a scatter of empty frames.
		     The veil that used to quiet the coil behind the overture's text goes with it: it existed to give
		     the opening one subject while a brand panel was being read, and there is no longer a panel. -->

		<!-- The scroll spacer: real page height, real scrollbar, real native paging. The runtime sets its
		     height from the number of works, so the scrollbar is honest about how much work remains. -->
		<div class="tv-scroll" data-tv-scroll aria-hidden="true"></div>

		<!-- THE OPENING (§3.1). In the baseline document this is the page heading + a quiet lead. Under the
		     active coil it is a small ORIENTATION MARK in the top-left corner, not a panel in the middle of
		     the screen: it says which room you are in and gets out of the way, exactly as the world mark does
		     at the bottom. It still fades on the first travel. The h1 stays for SEO/screen readers either way.
		     P14: it used to be a centred, scrimmed overlay ~40rem wide holding an eyebrow, a title and a
		     two-line lede across the middle of the crown — which is the second half of what the owner saw as
		     "an intro to get through", and it survived the overture being dismissed. The words are unchanged;
		     the composition is a corner, and the lede is dropped from the coil view (it remains in the
		     accessible document, where it is the page's real lead paragraph). -->
		<header class="pf-intro" data-pf-intro>
			<p class="pf-intro__eyebrow">Leonard Rieksen Fotografie</p>
			<h1 class="pf-intro__title">Portfolio</h1>
			<p class="pf-intro__lead">
				Een doorlopende reis door het werk van Leo Rieksen, architectuur en interieur, van complete
				reeksen tot losse beelden.
			</p>
		</header>

		<div class="tv-viewport">
			<!-- THE WORLD BEHIND THE COIL (Fase 5, D-75). A modelled blue-hour space, a stack of pre-painted
			     gradient layers whose OPACITY the chrome controller cross-fades along the journey (blue hour →
			     deep nocturne → warm interior), plus a slow, light-only breath. It lives BEHIND the ribbon (the
			     works are opaque and painted on top) and shows only in the negative space, so it can never fall
			     on a photograph (§6.16, the coil's one rule). Decorative and absent from the accessible document:
			     aria-hidden, and display:none until [data-tv-active] (see portfolio-chrome.css §2). -->
			<div class="tv-sky" aria-hidden="true">
				<div class="tv-sky__base"></div>
				<div class="tv-sky__cool"></div>
				<div class="tv-sky__warm"></div>
				<div class="tv-sky__breath"></div>
				<div class="tv-sky__haze"></div>
				<div class="tv-sky__vignette"></div>
			</div>
			<div class="tv-field" data-tv-stage>
				{
					worldSlices.map(({ world, works }) => (
						<section class="tv-world" data-tv-world={world.id} aria-labelledby={`world-${world.id}`}>
							{/* Wall text, not a room (§4.2): a quiet typographic chapter opening in the baseline;
							    hidden under the active coil, where the chrome names the world instead. */}
							<header class="tv-world__intro">
								<h2 class="tv-world__title" id={`world-${world.id}`}>
									{world.label}
								</h2>
								<p class="tv-world__meta">
									<span class="tv-world__count">{world.count}</span>
									<span class="tv-world__sub">{world.sub}</span>
								</p>
							</header>
							{works.map((it) => {
								const gi = world.start + works.indexOf(it); // global index → LCP priority for the crown
								const ar = it.ar || 1.5;
								const full = fulls.get(it);
								const isSeries = Boolean(it.href);
								const media = (
									/* NO `priority` HERE (P15). See loadIfNear() in traverse.js: an eager image in the
									   coil is fetched by the preload scanner, at the no-JS `sizes`, before the
									   parse-time stash script below can run — and then cancelled when it does.
									   MEASURED: six `net::ERR_ABORTED` requests on every load. The crown's high
									   fetch priority is applied by the engine at the moment it restores the
									   srcset, which is the moment the fetch actually happens. */
									<Media
										src={it.image}
										alt={it.alt}
										sizes={SIZES}
										widths={[600, 900, 1300, 1700]}
									/>
								);
								/* PROJECT RECOGNITION (Phase 4, D-74). A SERIES announces itself as enterable, its
								   title, then a gold hairline that draws in with the caption, then a "reeks"
								   affordance with an arrow. This is visual hierarchy in the photograph's OWN caption
								   (title + count), never a button, card or label bolted on: a project arriving at its
								   reading moment simply reads as "here a body of work begins", where a loose work reads
								   as one quiet line. A LOOSE work carries a real lightbox anchor (openable without JS);
								   a SERIES carries a real <a> to its richer project page. */
								const caption = isSeries ? (
									<figcaption class="tv-cap tv-cap--series">
										<span class="tv-cap__title">{it.caption ?? it.label}</span>
										<span class="tv-cap__rule" aria-hidden="true"></span>
										<span class="tv-cap__more">
											{it.label}
											<span class="tv-cap__arrow" aria-hidden="true">&#8594;</span>
										</span>
									</figcaption>
								) : (
									<figcaption class="tv-cap">{it.caption ?? it.label}</figcaption>
								);
								const inner = (
									<>
										{media}
										{caption}
									</>
								);
								/* Every work is a tab stop. Focusing a work travels the camera to it, so keyboard and
								   scroll traversal are one journey. */
								return (
									<figure
										class="tv-work"
										id={`work-${it.id}`}
										data-tv-work
										data-world={world.id}
										data-kind={isSeries ? 'series' : 'work'}
										data-ar={ar.toFixed(4)}
									>
										{isSeries ? (
											<a href={it.href} class="tv-work__link">
												{inner}
											</a>
										) : (
											<a
												href={full}
												class="tv-work__link"
												data-lightbox={`pf-${world.id}`}
												data-lb-full={full}
												data-lb-w={it.image.width}
												data-lb-h={it.image.height}
												data-lb-alt={it.alt}
												data-lb-caption={it.caption ?? it.label}
												aria-label={`Bekijk vergroot: ${it.alt}`}
											>
												{inner}
											</a>
										)}
									</figure>
								);
							})}
						</section>
					))
				}
				{
					/* Decorative top-fill; positioned by the runtime at negative ribbon angle, never present
					   without JavaScript, never part of any world. */
					leadItems.map((it, li) => {
						const ar = it.ar || 1.5;
						/* D-84 gave the first three lead-ins — CROWN imagery, what fills the top of the frame at
						   journey 0 — the same fetch priority as the first works. P15 keeps that intent and moves
						   it into `loadIfNear()`, for the reason documented there and on the works above: an eager
						   image in the coil is speculatively fetched at the wrong size and then cancelled. */
						return (
							<figure class="tv-work tv-lead" data-tv-lead data-ar={ar.toFixed(4)} aria-hidden="true">
								<Media src={it.image} alt="" sizes={SIZES} widths={[600, 900]} />
							</figure>
						);
					})
				}
			</div>
		</div>

		<!-- ============================================================================================= *
		     P9 (D-80), IMAGE-DELIVERY DISCIPLINE FOR THE COIL.

		     THE DEFECT. Every panel in the coil is absolutely positioned inside one fixed stage, so its LAYOUT
		     box sits inside the viewport whatever the camera is doing. Native `loading="lazy"` therefore judged
		     the entire archive to be in view and fetched it at once, measured on the built site: 47 of the 62
		     photographs and 3.0 MB on a 1440×900 desktop, 56 and 3.2 MB on a 390pt phone, at scroll position 0,
		     while the engine was drawing 12–14 of them. And it fetched them at the WRONG SIZE: <Media> renders a
		     <Picture>, so the browser selects from the first matching <source>, and that <source> carried the
		     server-rendered `sizes`, which describes the no-JS single column (92vw / 62rem), not the coil, where
		     a photograph presents at roughly a third of that. A 339px panel was served the 1700w derivative.

		     THE FIX, in one move. This script, deliberately `is:inline` and in parser position, because a module
		     script is far too late, stashes every coil `srcset` in `data-tv-srcset`. Nothing in the coil is then
		     fetched from the markup at all. traverse.js measures, writes each work's TRUE presented width to its
		     <source> elements, and restores the srcset for the works near the camera (CFG.loadAhead), so every
		     photograph is requested at the right size and only when it is genuinely approaching. (P14: the entrance curtain
		     that used to wait on that restored crown is deleted — see the note at the top of this file — but
		     the delivery discipline this script sets up is unchanged and is now what makes an immediate,
		     ungated arrival resolve into the crown rather than into empty frames.)

		     GUARDS. Runs only when JavaScript is live AND motion is welcome, exactly when the coil will mount.
		     Without JS nothing here executes; under reduced motion it returns before stashing. In both of those
		     the accessible chaptered column keeps every photograph at the size its own `sizes` describes, which
		     is why that server-rendered hint stays exactly as it was. A load-time failsafe restores anything
		     still stashed if the coil never activates, so no runtime failure can cost a photograph. -->
		<script is:inline>
			(function () {
				var root = document.querySelector('[data-tv-root]');
				if (!root || !document.documentElement.classList.contains('js')) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				var els = root.querySelectorAll(
					'[data-tv-work] source[srcset], [data-tv-work] img[srcset], [data-tv-lead] source[srcset], [data-tv-lead] img[srcset]'
				);
				for (var i = 0; i < els.length; i++) {
					var el = els[i];
					el.setAttribute('data-tv-srcset', el.getAttribute('srcset'));
					el.removeAttribute('srcset');
					if (el.tagName === 'IMG') {
						var src = el.getAttribute('src');
						if (src) {
							el.setAttribute('data-tv-src', src);
							el.removeAttribute('src');
						}
					}
				}

				/* FAILSAFE. If the coil never activates, a runtime error, an environment that refuses the 3D
				   field, no photograph may stay stashed. One pass shortly after load restores everything the
				   engine has not already claimed, so the worst case is the previous behaviour, never a gap. */
				window.setTimeout(function () {
					if (root.hasAttribute('data-tv-active')) return;
					root.removeAttribute('data-tv-boot'); // the coil never came — hand the page back to the document
					var stuck = root.querySelectorAll('[data-tv-srcset]');
					for (var n = 0; n < stuck.length; n++) {
						var e = stuck[n];
						e.setAttribute('srcset', e.getAttribute('data-tv-srcset'));
						if (e.hasAttribute('data-tv-src')) {
							e.setAttribute('src', e.getAttribute('data-tv-src'));
							e.removeAttribute('data-tv-src');
						}
						e.removeAttribute('data-tv-srcset');
					}
				}, 6000);
			})();
		</script>

		<!-- ===================== INTEGRATION CHROME (active coil only) ===================== -->
		<!-- All of this is hidden until [data-tv-active] (see portfolio-chrome.css): under no-JS and reduced
		     motion the three headed chapters above are the wayfinding, and none of this exists. -->

		<!-- ============================================================================================= *
		     THE WORLD MARK (P15) — the portfolio's navigation, at chrome scale.

		     WHAT WAS HERE. A bordered, near-opaque, backdrop-blurred RAIL carrying three labels and three
		     counts in two lines each, spanning the full width of a phone. Its information was right — all
		     three worlds present, current one marked, one tap to travel — and the owner's verdict is a list
		     of size complaints: too big, too textual, too dominant on a phone, visually too present, not
		     immediately legible as navigation. Those are one complaint: it was a WIDGET, on a page whose
		     whole subject is photographs.

		     WHAT IT IS NOW. The same three destinations as three words: one line of uppercase micro-type in
		     the bottom-left corner, hairline-separated, current world lit and ticked in gold, over an
		     edgeless corner wash. No box, no border, no fill, no backdrop-filter, no visible counts. The
		     counts move into each anchor's accessible name, where they are more use and cost the corner
		     nothing; the collection's proportions are still SHOWN, by the boundary ticks on the progress
		     hairline. The ink is 12px; every target is still >=44px tall (WCAG 2.5.8).

		     THE MARKUP IS THE FALLBACK, unchanged since P14: three real anchors to real `#work-<id>`
		     targets, in the document, in tab order, working without JavaScript and without the engine
		     (where they simply scroll the accessible chaptered column to that world). The chrome script
		     upgrades a click into an instant, exact `focusWork()` — the same D-73 travel as before. -->
		<nav class="pf-worlds" data-pf-worlds-nav aria-label="Portfolio-werelden">
			<!-- CROSSING INTO A WORLD (§6). The world's name and its one-line descriptor, lit for a beat
			     directly above the mark when the visitor crosses a boundary, with a gold hairline beside
			     them. It is deliberately in the corner the navigation already owns rather than over the
			     work: the P14 answer to this was a full-viewport scrim under a display-size heading, which
			     is exactly the "same interruption again when changing worlds" the owner reported. A world
			     change is navigation, so its announcement belongs to the navigation — and a name appearing
			     where there was no name is the clearest signal a corner can give. It covers no photograph,
			     dims nothing and needs no dismissal. aria-hidden: the anchors' own `aria-current` already
			     carries this state for assistive technology. -->
			<p class="pf-worlds__note" data-pf-note aria-hidden="true">
				<span class="pf-worlds__note-name" data-pf-note-name></span>
				<span class="pf-worlds__note-sub" data-pf-note-sub></span>
			</p>
			<div class="pf-worlds__rail">
				{
					worlds.map((w, i) => (
						<a
							class="pf-world"
							href={`#${w.anchorId}`}
							data-pf-jump={w.id}
							data-pf-index={w.start}
							aria-current={i === 0 ? 'true' : undefined}
							aria-label={`${w.label}, ${w.count} beelden`}
						>
							<span class="pf-world__label">{w.label}</span>
							{/* Visually hidden — the number lives in the accessible name above. Kept in the
							    markup so the no-JS document, where this nav is a plain list of anchors,
							    still carries it for anyone reading the page source or with CSS off. */}
							<span class="pf-world__count">{w.count}</span>
						</a>
					))
				}
				<!-- THE PROPORTIONAL MAP. One hairline under the three words: the fill and the node give the
				     exact position along the whole coil, and one tick per boundary shows where the
				     collection actually divides (D-74) — which is where the relative sizes that the P14
				     rail carried in two extra lines of type now live.
				     The `aria-label` on each anchor exists because the visible text is one word, and the
				     count beside it would otherwise be concatenated to "Interieur7" — a number that says
				     nothing. The accessible name states what the number IS and still CONTAINS the visible
				     label, so WCAG 2.5.3 (Label in Name) holds and voice control can still say "Interieur". -->
				<span class="pf-worlds__track" aria-hidden="true">
					<span class="pf-worlds__fill" data-pf-progress-fill></span>
					{
						worlds
							.slice(1)
							.map((w) => (
								<span
									class="pf-worlds__tick"
									style={`left:${((w.start / totalWorks) * 100).toFixed(2)}%`}
								/>
							))
					}
				</span>
				<span class="pf-worlds__node" data-pf-node aria-hidden="true"></span>
			</div>
		</nav>

		<!-- The world boundaries, for the chrome controller. Structural data only (a JSON data island). -->
		<script type="application/json" data-tv-worlds is:inline set:html={JSON.stringify(worlds)}></script>
	</div>

	<!-- After the journey: the contact invitation, then the site footer flow in below the fixed coil once the
	     outro has dissolved it (owner: "de footer hoort NA de reis"). Present without JavaScript too. -->
	<ContactCta
		heading="Een gebouw dat gefotografeerd wil worden?"
		primaryLabel="Neem contact op"
		primaryHref="/contact/"
	/>

	<Lightbox />
</BaseLayout>

<script>
	import { mountTraverse } from '../../scripts/traverse.js';
	import { mountChrome } from '../../scripts/portfolio-chrome.js';

	const root = document.querySelector('[data-tv-root]');
	if (root) {
		// The chrome reads the world from the SAME journey the coil is drawn from, via the runtime's onFrame
		// seam. Under reduced motion the runtime never mounts, so onFrame never fires and the chrome stays in
		// its static state (the headed chapters do the wayfinding).
		const chrome = mountChrome(root);
		// P14: THE ENGINE MOUNTS IMMEDIATELY. It used to be gated behind `mountIntro`, which held a brand
		// curtain over the page until the crown photography had decoded (or 4.2 s elapsed). That controller
