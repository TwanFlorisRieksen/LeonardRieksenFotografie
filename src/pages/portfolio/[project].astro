---
/*
 * Project detail (P6 recovery #2 — D-35). One maintainable template with a bounded set of OPENING
 * treatments, now with a body that reads as a composed page instead of a PDF-like plate stack.
 *
 * What changed vs D-34:
 *   · the beeldreeks is composed as JUSTIFIED ROWS + pano anchors (composeGallery), the same vocabulary as
 *     the overview, so a larger project forms varied rows rather than a vertical column of full plates;
 *   · the intro/meta zone gains the site's brand grammar — an atmosphere field + the gold structural seam —
 *     so a project page reads as the same premium system as the homepage and overview;
 *   · every project closes on a "Meer projecten" rail (RelatedProjects), so a two-image project ends on a
 *     full, considered beat instead of a large empty tail, and navigation into the rest of the work is easy.
 * Preserved: routes, SEO, leadLayout openings, whole-image (no-crop) photography, the shared lightbox,
 * factual content, and the image pipeline / PH-08.
 */
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import Lightbox from '../../components/Lightbox.astro';
import RelatedProjects from '../../components/RelatedProjects.astro';
import { composeGallery } from '../../lib/portfolio';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({ params: { project: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const LB = 'project';

const categoryLabel: Record<string, string> = { architectuur: 'Architectuur', interieur: 'Interieur' };

const serviceReturn: Record<string, { href: string; label: string }> = {
	architectuur: { href: '/diensten/architectuurfotografie/', label: 'Meer over architectuurfotografie' },
	interieur: { href: '/diensten/interieurfotografie/', label: 'Meer over interieurfotografie' },
};
const service = serviceReturn[data.category];

const seoTitle = data.seoTitle ?? data.title;
const seoDescription = data.seoDescription ?? data.summary;
const ogSourceImage = data.socialImage ?? data.coverImage;
const ogImage = await getImage({ src: ogSourceImage, width: 1200, format: 'jpeg' });

// duo-lead consumes the first gallery image in the opening; the rest form the sequence below.
const layout = data.leadLayout;
const duoPartner = layout === 'duo-lead' ? data.gallery[0] : undefined;
const gallerySource = duoPartner ? data.gallery.slice(1) : data.gallery;
const galleryNodes = composeGallery(gallerySource);

// "Meer projecten" close — real projects, same category first, then the rest; never the current one.
const allProjects = await getCollection('projects', ({ data: d }) => !d.draft);
const others = allProjects.filter((p) => p.id !== project.id);
const related = [
	...others.filter((p) => p.data.category === data.category),
	...others.filter((p) => p.data.category !== data.category),
].slice(0, 4);
---

<BaseLayout title={seoTitle} description={seoDescription} socialImage={ogImage.src}>
	<article class={`proj proj--${layout}`}>
		<!-- ===================== OPENING ===================== -->
		{
			layout === 'editorial' ? (
				<Section tight as="header" class="proj-open proj-open--editorial">
					<p class="t-eyebrow t-eyebrow--accent proj-open__eyebrow">
						{categoryLabel[data.category]}
						{data.location && <> &middot; {data.location}</>}
						{data.year && <> &middot; {data.year}</>}
					</p>
					<h1 class="t-display proj-open__title">{data.title}</h1>
					<p class="t-lead proj-open__lead">{data.summary}</p>
				</Section>
			) : (
				<header class="proj-open">
					<div class={`proj-open__frame ${layout === 'cinematic' ? 'proj-open__frame--wide' : 'proj-open__frame--duo'}`}>
						{layout === 'duo-lead' && duoPartner ? (
							<div class="proj-open__duo">
								<PhotoFrame image={data.coverImage} alt={data.coverImageAlt} group={LB} priority widths={[600, 1000, 1400]} sizes="(min-width: 52rem) 58vw, 100vw" />
								<PhotoFrame image={duoPartner.image} alt={duoPartner.alt} caption={duoPartner.caption} group={LB} priority widths={[480, 800, 1100]} sizes="(min-width: 52rem) 40vw, 100vw" />
							</div>
						) : (
							<PhotoFrame image={data.coverImage} alt={data.coverImageAlt} group={LB} priority widths={[800, 1200, 1700, 2200]} sizes="100vw" mediaClass="proj-open__media" />
						)}
					</div>
					<div class="proj-open__headings u-container">
						<p class="t-eyebrow t-eyebrow--accent">
							{categoryLabel[data.category]}
							{data.location && <> &middot; {data.location}</>}
							{data.year && <> &middot; {data.year}</>}
						</p>
						<h1 class="t-display proj-open__title">{data.title}</h1>
					</div>
				</header>
			)
		}

		<!-- ===================== INTRO: spec sheet + story ===================== -->
		<Section tight class="proj-intro-sec">
			<div class={`proj-intro ${layout === 'editorial' ? 'proj-intro--lead-shown' : ''}`}>
				<dl class="proj-meta">
					<div class="proj-meta__row">
						<dt class="t-caption">Categorie</dt>
						<dd>{categoryLabel[data.category]}</dd>
					</div>
					{data.location && (
						<div class="proj-meta__row">
							<dt class="t-caption">Locatie</dt>
							<dd>{data.location}</dd>
						</div>
					)}
					{data.year && (
						<div class="proj-meta__row">
							<dt class="t-caption">Jaar</dt>
							<dd>{data.year}</dd>
						</div>
					)}
					<div class="proj-meta__row">
						<dt class="t-caption">Beelden</dt>
						<dd>{data.gallery.length + 1}</dd>
					</div>
				</dl>
				<div class="prose proj-intro__text">
					{layout !== 'editorial' && <p class="t-lead proj-intro__lead">{data.summary}</p>}
					<Content />
				</div>
			</div>
		</Section>

		<!-- Editorial layout shows its lead image here, AFTER the quiet typographic opening. -->
		{
			layout === 'editorial' && (
				<Section tight width="wide" as="div" class="proj-editorial-lead">
					<PhotoFrame image={data.coverImage} alt={data.coverImageAlt} group={LB} widths={[800, 1200, 1700]} sizes="(min-width: 90rem) 84rem, 100vw" mediaClass="proj-open__media" />
				</Section>
			)
		}

		<!-- ===================== BEELDREEKS (justified rows + pano anchors) ===================== -->
		{
			galleryNodes.length > 0 && (
				<Section tight width="wide" as="div" class="proj-gallery-sec">
					<div class="proj-seam" aria-hidden="true" />
					<div class="proj-flow">
						{galleryNodes.map((node) =>
							node.type === 'anchor' ? (
								<div class="proj-anchor">
									<PhotoFrame image={node.item.image} alt={node.item.alt} caption={node.item.caption} group={LB} widths={[900, 1300, 1700, 2200]} sizes="(min-width: 90rem) 84rem, 100vw" showCaption />
								</div>
							) : (
								<div class="proj-row">
									{node.items.map((it) => (
										<div class="proj-cell" style={`--ar:${it.ar.toFixed(4)}`} data-o={it.orientation}>
											<PhotoFrame image={it.image} alt={it.alt} caption={it.caption} group={LB} widths={[480, 800, 1100]} sizes="(min-width: 60rem) 42vw, 92vw" showCaption />
										</div>
									))}
								</div>
							),
						)}
					</div>
				</Section>
			)
		}

		<!-- ===================== OUTRO NAV ===================== -->
		<div class="proj-outro u-container">
			<a class="proj-back" href="/portfolio/">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12H5M11 6l-6 6 6 6" /></svg>
				Terug naar portfolio
			</a>
			{service && (
				<a class="proj-service-link" href={service.href}>
					{service.label}
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
				</a>
			)}
		</div>
	</article>

	<RelatedProjects title="Meer projecten" projects={related} />

	<Lightbox />
</BaseLayout>

<style>
	/* ===================== OPENING ===================== */
	.proj-open {
		padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
	}
	.proj-open__frame {
		margin-inline: auto;
	}
	.proj-open__frame--wide {
		width: 100%;
	}
	.proj-open__frame--wide :global(.proj-open__media) {
		width: 100%;
	}
	.proj-open__frame--duo {
		width: min(100% - 2 * var(--gutter), var(--container-wide));
	}
	.proj-open__duo {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
		align-items: end;
	}
	.proj-open__headings {
		margin-top: clamp(1.25rem, 0.8rem + 1.5vw, 2.25rem);
	}
	.proj-open__title {
		margin-top: var(--space-sm);
		max-width: 22ch;
	}

	/* Editorial opening: quiet, typographic, image comes later. */
	.proj-open--editorial {
		padding-top: clamp(2rem, 1.2rem + 4vw, 4.5rem);
	}
	.proj-open--editorial .proj-open__title {
		margin-block: var(--space-sm) var(--space-md);
	}
	.proj-open--editorial .proj-open__lead {
		max-width: 52ch;
	}
	.proj-editorial-lead {
		margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
	}

	/* ===================== INTRO ===================== */
	/* Brand atmosphere: a quiet cool wash descending into the intro zone (the homepage "afterglow"
	   mechanism), so the reading beat sits in the same nocturne light as the rest of the site.
	   The vertical radius is a PERCENTAGE of this section's own (content-driven, variable) height — a longer
	   project description wraps to more lines and grows the box, and the old 56%/34% radii always faded to
	   zero at the same *fraction* of it, so the fixed alpha stops never actually reached the section's tail:
	   a flat, atmosphere-less band appeared before the gallery's gold seam on longer copy / narrower
	   viewports (P6.1 correction). Sized generously past 100% so the zero-stop always lands at/after the
	   box's own bottom edge regardless of content length — same anchor, alpha and colour, corrected reach. */
	.proj-intro-sec {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
	}
	.proj-intro-sec::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			radial-gradient(
				120% 160% at 12% -6%,
				rgba(var(--p-atmos-cool), 0.16) 0%,
				rgba(var(--p-atmos-cool), 0.05) 44%,
				rgba(var(--p-atmos-cool), 0) 72%
			),
			radial-gradient(
				52% 180% at 92% -4%,
				rgba(var(--p-atmos-warm), 0.07) 0%,
				rgba(var(--p-atmos-warm), 0) 62%
			);
	}
	.proj-intro {
		display: grid;
		grid-template-columns: 13rem 1fr;
		gap: var(--space-2xl);
	}
	.proj-meta {
		position: relative;
		display: flex;
		flex-direction: column;
		padding-top: var(--space-md);
	}
	.proj-meta::before {
		content: '';
		position: absolute;
		top: 0;
		width: clamp(2rem, 1.4rem + 2vw, 3rem);
		height: 1px;
		background: linear-gradient(90deg, rgba(224, 197, 140, 0.92) 0%, rgba(199, 165, 106, 0.5) 66%, rgba(199, 165, 106, 0) 100%);
	}
	.proj-meta__row {
		padding-block: var(--space-md);
		border-top: 1px solid var(--color-border-subtle);
	}
	.proj-meta__row:first-of-type {
		border-top: 0;
	}
	.proj-meta__row dt {
		color: var(--color-text-muted);
		margin-bottom: 2px;
	}
	.proj-meta__row dd {
		margin: 0;
		font-family: var(--font-sans);
		font-weight: var(--fw-medium);
		color: var(--color-text);
	}
	.proj-intro__lead {
		color: var(--color-text);
		margin-bottom: var(--space-md);
	}

	/* ===================== BEELDREEKS ===================== */
	.proj-gallery-sec {
		position: relative;
		isolation: isolate;
	}
	/* Gold structural seam marking the start of the beeldreeks — the one recurring elevated gold material. */
	.proj-seam {
		position: relative;
		height: 1px;
		margin-bottom: clamp(2rem, 1.4rem + 3vw, 3.75rem);
		background: var(--seam-gold);
	}
	.proj-seam::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
		background: var(--seam-gold-glow);
		pointer-events: none;
	}
	.proj-flow {
		display: flex;
		flex-direction: column;
		gap: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
	}
	.proj-row {
		display: flex;
		gap: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
		align-items: flex-start;
	}
	.proj-cell {
		flex: var(--ar) 1 0;
		min-width: 0;
	}
	.proj-row:has(> .proj-cell:only-child) {
		justify-content: center;
	}
	.proj-row > .proj-cell:only-child {
		flex: 0 1 min(100%, 52rem);
	}
	.proj-anchor {
		width: 100%;
	}

	/* ===================== OUTRO ===================== */
	.proj-outro {
		border-top: 1px solid var(--color-border-subtle);
		padding-block: var(--space-xl) var(--space-2xl);
		margin-top: clamp(3rem, 2rem + 4vw, 6rem);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md) var(--space-2xl);
	}
	.proj-back,
	.proj-service-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		font-size: var(--fs-body-sm);
		font-weight: var(--fw-semibold);
		color: var(--color-text-secondary);
		transition: color var(--dur-interaction) var(--ease-standard);
	}
	.proj-back:hover,
	.proj-back:focus-visible,
	.proj-service-link:hover,
	.proj-service-link:focus-visible {
		color: var(--color-text);
	}
	.proj-service-link:hover,
	.proj-service-link:focus-visible {
		color: var(--color-accent);
	}
	.proj-service-link svg,
	.proj-back svg {
		transition: transform var(--dur-interaction) var(--ease-out);
	}
	.proj-service-link:hover svg,
	.proj-service-link:focus-visible svg {
		transform: translateX(3px);
	}
	.proj-back:hover svg,
	.proj-back:focus-visible svg {
		transform: translateX(-3px);
	}

	/* ===================== RESPONSIVE ===================== */
	@media (max-width: 52rem) {
		.proj-open__duo {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}
	}
	@media (max-width: 40rem) {
		.proj-intro {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
		.proj-meta {
			flex-direction: row;
			flex-wrap: wrap;
			gap: var(--space-lg) var(--space-xl);
			padding-top: var(--space-lg);
		}
		.proj-meta__row {
			padding-block: 0;
			border-top: 0;
		}
		.proj-row {
			flex-wrap: wrap;
		}
		.proj-cell {
			flex: 1 1 100%;
		}
		.proj-cell[data-o='portrait'],
		.proj-cell[data-o='square'] {
			flex: 1 1 calc(50% - 0.5 * clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem));
		}
		.proj-row > .proj-cell:only-child {
			flex: 1 1 100%;
		}
	}
</style>
