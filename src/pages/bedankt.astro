---
/*
 * Bedankt, the contact form's success target (P5, D-31). Netlify redirects a successful submission to
 * this route (the form's `action="/bedankt/"`), preserving the old site's proven no-JS success flow
 * (blueprint 3.11, keep this confirmation behaviour) and satisfying 2.23's "bevestiging na verzending".
 * Deliberately calm and restrained, a reassuring confirmation and clear onward navigation, not a page
 * that competes with the site's content. noindex: a per-submission result page has no standalone search
 * value and should not be indexed. Content is a factual confirmation; nothing invented.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Media from '../components/Media.astro';
import sculptuurImg from '../assets/static/bedankt.jpg';
---

<BaseLayout
	title="Bericht verzonden"
	description="Bevestiging: uw bericht aan Leonard Rieksen Fotografie is verzonden."
	noindex
>
	<Section as="section" class="thanks">
		<div class="thanks__inner u-reveal">
			<span class="thanks__rule" aria-hidden="true" style="--reveal-index: 0"></span>
			<p class="t-eyebrow t-eyebrow--accent" style="--reveal-index: 1">Bericht verzonden</p>
			<h1 class="t-display thanks__title" style="--reveal-index: 2">Bedankt voor uw bericht.</h1>
			<p class="t-lead thanks__lead" style="--reveal-index: 3">
				Uw bericht is verzonden. Ik neem zo snel mogelijk persoonlijk contact met u op, meestal binnen
				een paar werkdagen.
			</p>
			<div class="thanks__actions" style="--reveal-index: 4">
				<a class="link-arrow" href="/">
					Terug naar home
					<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
				</a>
				<a class="link-arrow" href="/portfolio/">
					Bekijk het portfolio
					<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
				</a>
			</div>
		</div>
		<!-- P5.1 (D-32), the success page gains a deliberate premium image composition (owner-specified photograph):
		     an abstract architectural light-sculpture (gold armillary sphere on pure black, with green/red catch-lights).
		     Its pure-black field IS the escape mechanism, a radial mask dissolves the frame entirely so the sphere
		     FLOATS in the page's dark field (controlled image-escape, careful edge treatment), never a rectangle under
		     the text. An asymmetric editorial split (confirmation copy left, sculpture right) with strong negative
		     space; the image is already visually strong, so no extra decoration is added beyond the existing calm
		     cool-glow field. Decorative (alt=""): it sets a tone, it is not information the success message depends on. -->
		<figure class="thanks__figure u-inview" aria-hidden="true">
			<Media
				src={sculptuurImg}
				alt=""
				widths={[480, 720, 1000]}
				sizes="(min-width: 60rem) 42vw, 86vw"
				class="thanks__media"
			/>
		</figure>
	</Section>
</BaseLayout>

<style>
	.thanks {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		display: flex;
		align-items: center;
		min-height: min(78vh, 720px);
		background:
			radial-gradient(
				120% 60% at 50% -8%,
				rgba(var(--p-atmos-cool), 0.16) 0%,
				rgba(var(--p-atmos-cool), 0.05) 42%,
				rgba(var(--p-atmos-cool), 0) 72%
			),
			/* P8.6 (D-77): was a flat `--color-bg` under the afterglow, the radial dies at 72% and the rest
			   of a 720px-tall screen was one unlit colour. */
				var(--grad-sapphire-quiet);
	}
	/* P5.1 (D-32), asymmetric editorial split: confirmation copy (left) + the light-sculpture (right). The section
	   still vertically centres its content within the min-height; the grid places the two beats side by side. */
	.thanks :global(.u-container) {
		width: 100%;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(var(--space-xl), 1rem + 5vw, var(--space-4xl));
		align-items: center;
	}
	.thanks__inner {
		max-width: 42ch;
	}
	/* The sculpture floats in the page's dark field: a radial mask dissolves the pure-black frame entirely, so the
	   gold armillary reads as a light source suspended in the nocturne, a controlled escape, not a boxed picture.
	   Decorative (aria-hidden + alt=""), so no focus/alt burden; it sets tone only. */
	.thanks__figure {
		position: relative;
		isolation: isolate;
	}
	/* A dark tonal POOL behind the sculpture (owner's suggested depth device): the photograph's field is pure black,
	   so against the slightly-navy page its masked edges would otherwise hint at a rectangle. This near-black radial,
	   fading to the page, gives the masked edges darkness to dissolve INTO, the sphere sits in a pool of shadow and
	   truly floats. Restrained (no colour, no glow of its own, the vivid image stays the only light source). */
	.thanks__figure::before {
		content: '';
		position: absolute;
		inset: -14% -10%;
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(70% 70% at 52% 47%, #05070b 0%, rgba(5, 7, 11, 0.6) 42%, rgba(5, 7, 11, 0) 78%);
	}
	.thanks__media {
		-webkit-mask-image: radial-gradient(76% 76% at 52% 47%, #000 54%, transparent 100%);
		mask-image: radial-gradient(76% 76% at 52% 47%, #000 54%, transparent 100%);
	}
	/* A single champagne datum rule, the confirmation mark, in the site's selective gold hairline language. */
	.thanks__rule {
		display: block;
		width: clamp(2.5rem, 1.6rem + 3vw, 4rem);
		height: 1px;
		margin-bottom: var(--space-lg);
		background: linear-gradient(
			90deg,
			rgba(var(--p-champagne-rgb), 0.92) 0%,
			rgba(var(--p-gold-rgb), 0.5) 55%,
			rgba(var(--p-gold-rgb), 0) 100%
		);
	}
	.thanks__title {
		margin-top: var(--space-md);
		max-width: 14ch;
	}
	.thanks__lead {
		margin-top: var(--space-lg);
		max-width: 46ch;
		color: var(--color-text);
	}
	.thanks__actions {
		margin-top: var(--space-xl);
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md) var(--space-xl);
	}
	/* The confirmation copy leads; the sculpture follows below, centred and bounded so it stays a calm accent. */
	@media (max-width: 52rem) {
		.thanks :global(.u-container) {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
		.thanks__figure {
			max-width: 24rem;
			margin-inline: auto;
		}
	}
</style>
