---
/*
 * Interieurfotografie — service detail (P4 — D-19). Same blueprint skeleton as the architecture page
 * (13.40) but a deliberately DIFFERENT experience: a warm, atmospheric hero, black-and-white spatial
 * studies in the representative set, and an emphasis on space, material, light, atmosphere and function
 * (rather than exterior structure/overview). Not the architecture page with nouns swapped — different
 * photography, different representatief rhythm, different content emphasis. Copy transformed from Leo's own
 * site + real-portfolio observation; no invented facts, no overstatement (13.41). Photography real (PH-08).
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Media from '../../components/Media.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import RelatedProjects from '../../components/RelatedProjects.astro';
import ContactCta from '../../components/ContactCta.astro';
import heroImg from '../../assets/static/eemhuis-bibliotheek.jpg';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const kroller = projects.find((p) => p.id === 'kroller-muller-paviljoen');
const arnhem = projects.find((p) => p.id === 'arnhem-stadsarchitectuur');
const related = ['kroller-muller-paviljoen', 'arnhem-stadsarchitectuur']
	.map((id) => projects.find((p) => p.id === id))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));

const ogImage = await getImage({ src: heroImg, width: 1200, format: 'jpeg' });

const toepassingen = [
	'Woningen & interieurs',
	'Kantoren & werkplekken',
	'Horeca & retail',
	'Zorg & publieke ruimtes',
];
---

<BaseLayout
	title="Interieurfotografie"
	description="Interieurfotografie op locatie door Leo Rieksen — ruimtes waarin sfeer, materiaal, licht en functie samenkomen, in bestaand en zorgvuldig aangevuld licht."
	socialImage={ogImage.src}
>
	<ServiceHero
		image={heroImg}
		alt="De leeszaal van het Eemhuis in Amersfoort met een golvend, verlicht plafond boven warme houten leestafels."
		eyebrow="Diensten · Interieurfotografie"
		title="Interieurfotografie"
		sub="Ruimtes waarin sfeer, materiaal, licht en functie samenkomen."
		position="center 55%"
		parentHref="/diensten/"
		parentLabel="Alle diensten"
	/>

	<!-- Intro -->
	<Section tight>
		<div class="svc-intro">
			<p class="t-lead svc-intro__lead">
				Een interieur werkt pas echt als je de sfeer voelt. Goede interieurfotografie brengt ruimte,
				materiaal en licht samen tot een beeld dat klopt — rustig en zonder opsmuk.
			</p>
			<div class="prose">
				<p>
					Leo fotografeert interieurs op locatie, met veel aandacht voor het aanwezige licht. Van een
					woning of kantoor tot horeca, zorg en publieke ruimtes: door standpunt, compositie en
					belichting zorgvuldig te kiezen, komen de indeling, de materialen en de functie van een
					ruimte overtuigend in beeld — bestaand licht aangevuld met gericht kunstlicht waar dat de
					sfeer versterkt.
				</p>
			</div>
		</div>
	</Section>

	<!-- Representatieve fotografie: black-and-white spatial studies — a distinct rhythm from the arch page -->
	{
		kroller && (
			<Section as="div" width="wide">
				<figure class="svc-lead-plate u-inview">
					<Media
						src={kroller.data.coverImage}
						alt={kroller.data.coverImageAlt}
						widths={[640, 1024, 1400, 1700]}
						sizes="100vw"
						class="svc-lead-plate__media"
					/>
					<figcaption class="t-caption svc-lead-plate__cap">
						Ruimte, licht en materiaal — paviljoen bij het Kröller-Müller Museum.
					</figcaption>
				</figure>
			</Section>
		)
	}
	{
		arnhem && (
			<Section as="div" surface="deep" tight class="svc-duo-section">
				<div class="svc-duo">
					<figure class="svc-duo__media u-inview">
						<Media
							src={arnhem.data.gallery[arnhem.data.gallery.length - 1].image}
							alt={arnhem.data.gallery[arnhem.data.gallery.length - 1].alt}
							widths={[360, 640, 900]}
							sizes="(min-width: 48rem) 30rem, 80vw"
							class="svc-duo__img"
						/>
					</figure>
					<div class="svc-duo__text u-inview" style="--reveal-index: 1">
						<p class="t-eyebrow t-eyebrow--accent">Vorm & functie</p>
						<p class="svc-duo__quote">
							Lijnen, ritme en de manier waarop mensen zich door een ruimte bewegen — ook binnen een
							gebouw vertelt de architectuur haar eigen verhaal.
						</p>
						<p class="t-caption svc-duo__cap">
							Interieurarchitectuur — stationstrap, Arnhem Centraal.
						</p>
					</div>
				</div>
			</Section>
		)
	}

	<!-- LATE CHAPTER (P4 correction #4 — D-23). The light column is retired. Both beats are now DARK, keeping the
	     interior page deliberately CALMER than the architecture page (fewer tonal switches — its tonal depth
	     comes from the deep B&W duo above and the deep related gallery below, not a stepped uitleg band). The
	     uitleg ("De dienst") reads on the base-dark page (the atmospheric, reflective voice); the werkwijze
	     becomes a dark two-column vertical SEQUENCE (head rail left, a slow numbered cadence right) — the
	     interior page's late, sequential, spatial identity. Distinct from the architecture werkwijze (head-on-top
	     + compact 3-col grid), so the two service pages stay compositionally different. -->
	<Section as="section" class="svc-uitleg-sec">
		<div class="svc-scope">
			<div class="svc-scope__text">
				<p class="t-eyebrow t-eyebrow--accent">De dienst</p>
				<h2 class="t-h2 svc-scope__title">Wat interieurfotografie oplevert.</h2>
				<p class="svc-scope__body">
					Beelden die een ruimte op haar best laten zien: voor de website, een portfolio, verhuur of
					verkoop, of een publicatie. Interieurfotografie maakt sfeer, materiaal en indeling voelbaar
					— zodat wie de foto ziet, begrijpt hoe het is om er te zijn.
				</p>
			</div>
			<div class="svc-scope__aside">
				<p class="t-eyebrow svc-scope__aside-label">Toepassingen</p>
				<ul class="svc-applist">
					{toepassingen.map((t) => <li class="svc-applist__item">{t}</li>)}
				</ul>
			</div>
		</div>
	</Section>

	<Section as="section" class="svc-seq-sec">
		<div class="svc-seq">
			<div class="svc-seq__head">
				<p class="t-eyebrow t-eyebrow--accent">Werkwijze</p>
				<h2 class="t-h2 svc-seq__title">Van sfeer tot beeld.</h2>
			</div>
			<ol class="svc-seq__list">
				<li class="svc-seq__item u-inview">
					<span class="svc-seq__num">01</span>
					<div class="svc-seq__body">
						<h3 class="t-h4 svc-seq__name">Voorbereiding</h3>
						<p>
							Vooraf bespreken we welke ruimtes in beeld komen, waarvoor de beelden worden gebruikt en
							welke sfeer gewenst is. Daarop stemmen we routing, belichting en het tijdstip af.
						</p>
					</div>
				</li>
				<li class="svc-seq__item u-inview" style="--reveal-index: 1">
					<span class="svc-seq__num">02</span>
					<div class="svc-seq__body">
						<h3 class="t-h4 svc-seq__name">Op locatie</h3>
						<p>
							Rustig en precies gewerkt: het aanwezige licht wordt aangevuld met gericht kunstlicht,
							lijnen worden rechtgezet en storende elementen waar mogelijk verplaatst of weggehaald.
						</p>
					</div>
				</li>
				<li class="svc-seq__item u-inview" style="--reveal-index: 2">
					<span class="svc-seq__num">03</span>
					<div class="svc-seq__body">
						<h3 class="t-h4 svc-seq__name">Nabewerking</h3>
						<p>
							Een terughoudende nabewerking waarin kleur, licht en materiaal natuurlijk blijven — de
							ruimte blijft leidend, het beeld laat de sfeer spreken.
						</p>
					</div>
				</li>
			</ol>
		</div>
	</Section>

	<RelatedProjects projects={related} />

	<ContactCta
		eyebrow="Aan de slag"
		heading="Een ruimte die op haar best in beeld moet?"
		text="Neem vrijblijvend contact op voor een voorstel op maat van uw interieur."
		primaryLabel="Neem contact op"
		primaryHref="/contact/"
		secondaryLabel="Architectuurfotografie"
		secondaryHref="/diensten/architectuurfotografie/"
	/>
</BaseLayout>

<style>
	/* --- Intro --- */
	.svc-intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		align-items: start;
	}
	.svc-intro__lead {
		color: var(--color-text);
		max-width: none;
		font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.75rem);
		line-height: 1.4;
	}
	@media (max-width: 52rem) {
		.svc-intro {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
	}

	/* --- Representative: a large full-bleed B&W plate + a contained portrait study --- */
	.svc-lead-plate__cap {
		margin-top: var(--space-sm);
	}
	.svc-duo {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		align-items: center;
	}
	.svc-duo__img {
		max-width: 30rem;
	}
	.svc-duo__quote {
		font-family: var(--font-display);
		font-weight: var(--fw-display-soft);
		font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.7rem);
		line-height: 1.35;
		letter-spacing: var(--ls-heading);
		color: var(--color-text);
		margin-block: var(--space-md) var(--space-lg);
		max-width: 28ch;
	}
	@media (max-width: 52rem) {
		.svc-duo {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
			align-items: start;
		}
		.svc-duo__img {
			max-width: 24rem;
		}
	}

	/* --- Uitleg + toepassingen: now on the DARK page (the reflective intro voice) --- */
	.svc-scope {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		align-items: start;
	}
	.svc-scope__title {
		margin-block: var(--space-sm) var(--space-md);
		max-width: 16ch;
	}
	.svc-scope__body {
		color: var(--color-text-secondary);
		max-width: 52ch;
	}
	.svc-scope__aside-label {
		color: var(--color-accent);
	}
	.svc-applist {
		margin-top: var(--space-md);
		display: flex;
		flex-direction: column;
	}
	.svc-applist__item {
		padding: var(--space-md) 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-text);
		font-weight: var(--fw-medium);
	}
	.svc-applist__item:last-child {
		border-bottom: 1px solid var(--color-border);
	}
	@media (max-width: 52rem) {
		.svc-scope {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}

	/* --- Werkwijze: an all-dark two-column vertical SEQUENCE (D-23) — head rail left, a slow numbered cadence
	   right, with generous vertical rhythm and negative space (the interior page's calm, sequential, spatial
	   identity). No light column. Distinct from the architecture werkwijze's head-on-top + 3-col grid. --- */
	.svc-seq {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: var(--space-2xl) clamp(var(--space-3xl), 2rem + 5vw, var(--space-4xl));
		align-items: start;
	}
	.svc-seq__head {
		max-width: 30ch;
	}
	.svc-seq__title {
		margin-top: var(--space-sm);
	}
	.svc-seq__list {
		display: flex;
		flex-direction: column;
	}
	.svc-seq__item {
		display: grid;
		grid-template-columns: minmax(0, 5rem) minmax(0, 46ch);
		gap: var(--space-lg) var(--space-2xl);
		padding-block: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
		border-top: 1px solid var(--color-border);
		align-items: baseline;
	}
	.svc-seq__item:first-child {
		padding-top: 0;
		border-top: 0;
	}
	.svc-seq__num {
		font-family: var(--font-display);
		font-weight: var(--fw-display);
		font-size: var(--fs-h2);
		line-height: 1;
		color: var(--color-accent);
		letter-spacing: var(--ls-heading);
	}
	.svc-seq__name {
		color: var(--color-text);
		margin-bottom: var(--space-sm);
	}
	.svc-seq__body p {
		color: var(--color-text-secondary);
		font-size: var(--fs-body-sm);
	}
	@media (max-width: 52rem) {
		.svc-seq {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
	@media (max-width: 40rem) {
		.svc-seq__item {
			grid-template-columns: 1fr;
			gap: var(--space-xs);
		}
	}
</style>
