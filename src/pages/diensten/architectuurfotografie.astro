---
/*
 * Architectuurfotografie — service detail (P4 — D-19). Structure per blueprint 13.40 (intro · representatieve
 * fotografie · uitleg · toepassingen · werkwijze · relevante projecten · contact-CTA) but with content,
 * photography and rhythm specific to ARCHITECTURE — dramatic exterior/urban imagery, an emphasis on
 * structure, proportion, line, light and overview (incl. hoogtefotografie). Deliberately NOT the interior
 * page with nouns swapped. Copy transformed from Leo's own site + observation of his real portfolio; no
 * invented facts, no commercial overstatement (13.41). Photography real (PH-08 derivatives).
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Media from '../../components/Media.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import RelatedProjects from '../../components/RelatedProjects.astro';
import ContactCta from '../../components/ContactCta.astro';
import heroImg from '../../assets/static/diensten-rotterdam.jpeg';
import amersfoortImg from '../../assets/static/amersfoort-toren.jpg';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const arnhem = projects.find((p) => p.id === 'arnhem-stadsarchitectuur');
const related = ['arnhem-stadsarchitectuur', 'rotterdam-skyline-kubuswoningen']
	.map((id) => projects.find((p) => p.id === id))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));

const ogImage = await getImage({ src: heroImg, width: 1200, format: 'jpeg' });

const toepassingen = [
	'Kantoren & bedrijfspanden',
	'Publieke & historische gebouwen',
	'Nieuwbouw & moderne architectuur',
	'Stedelijke omgeving & hoogte',
];
---

<BaseLayout
	title="Architectuurfotografie"
	description="Architectuurfotografie op locatie door Leo Rieksen — gebouwen en exterieurs waarin structuur, proportie, licht en lijn tot hun recht komen, van monumenten tot moderne architectuur."
	socialImage={ogImage.src}
>
	<ServiceHero
		image={heroImg}
		alt="De skyline van Rotterdam met de Erasmusbrug onder een dramatische wolkenlucht, gezien vanaf hoogte."
		eyebrow="Diensten · Architectuurfotografie"
		title="Architectuurfotografie"
		sub="Gebouwen en exterieurs, vastgelegd met oog voor structuur, proportie, licht en lijn."
		position="center 40%"
		parentHref="/diensten/"
		parentLabel="Alle diensten"
	/>

	<!-- Intro -->
	<Section tight class="svc-intro-sec">
		<div class="svc-intro">
			<p class="t-lead svc-intro__lead">
				Een gebouw vertelt een verhaal door zijn vorm, materiaal en verhouding tot de omgeving. Goede
				architectuurfotografie maakt dat verhaal leesbaar — rustig, precies en zonder ruis.
			</p>
			<div class="prose">
				<p>
					Leo fotografeert architectuur op locatie: van historische gevels en monumenten tot moderne
					nieuwbouw en stedelijke overzichten. Rechte lijnen, zorgvuldig gekozen standpunten en het
					juiste licht zorgen ervoor dat de architectuur herkenbaar en overtuigend in beeld komt —
					waar nodig ook vanaf hoogte, voor het overzicht dat een gebouw in zijn omgeving plaatst.
				</p>
			</div>
		</div>
	</Section>

	<!-- Representatieve fotografie: historic + modern → the range of the discipline. Stepped onto the deepest
	     surface (ink-950, 6.9) as a distinct "gallery wall" chapter — an architectural, precise dark step that
	     differentiates this page's rhythm from the interior page (which sequences a full-bleed plate instead). -->
	<Section as="div" surface="deep" width="wide" class="svc-gallery">
		<p class="t-eyebrow t-eyebrow--accent svc-gallery__label">Representatief werk</p>
		<div class="svc-plates">
			<figure class="svc-plate svc-plate--tall u-inview">
				<Media
					src={amersfoortImg}
					alt="Een historische torenspits met de Onze Lieve Vrouwetoren van Amersfoort daarachter, tegen een bewolkte lucht."
					widths={[400, 700, 900]}
					sizes="(min-width: 52rem) 40vw, 100vw"
					class="svc-plate__media"
				/>
				<figcaption class="t-caption svc-plate__cap">
					Historische architectuur — Onze Lieve Vrouwetoren, Amersfoort.
				</figcaption>
			</figure>
			{
				arnhem && (
					<figure class="svc-plate svc-plate--wide u-inview" style="--reveal-index: 1">
						<Media
							src={arnhem.data.coverImage}
							alt={arnhem.data.coverImageAlt}
							widths={[480, 800, 1200]}
							sizes="(min-width: 52rem) 55vw, 100vw"
							class="svc-plate__media"
						/>
						<figcaption class="t-caption svc-plate__cap">
							Moderne architectuur — kantoortorens, Arnhem.
						</figcaption>
					</figure>
				)
			}
		</div>
	</Section>

	<!-- Uitleg + toepassingen (P4 correction #4 — D-23). The light plane is retired. Dark dominance is now the
	     compositional register (blueprint 6.8/6.9/6.15: predominantly dark neutrals, light neutrals for TEXT
	     only — never obligatory light surfaces). This "specification wall" steps up ONE dark tint to ink-850
	     (`surface`) — a subtle full-bleed tonal lift that reads as a distinct chapter without borders/shadows
	     (6.9), between the deepest gallery above (ink-950) and the base-dark werkwijze below (ink-900). Hierarchy
	     comes from the tonal step + an asymmetric grid (statement/body left, a precise gold-hairline toepassingen
	     index right) + scale contrast, all aligned to the wide representative-gallery grid so the photography
	     structures the composition (4.23). No card, no panel — a full-width dark tonal chapter. -->
	<Section as="section" surface="surface" width="wide" class="svc-scope-sec">
		<div class="svc-scope">
			<div class="svc-scope__main">
				<p class="t-eyebrow t-eyebrow--accent">De dienst</p>
				<h2 class="t-h2 svc-scope__title">Wat architectuurfotografie oplevert.</h2>
				<p class="svc-scope__body">
					Sterke beelden van een gebouw werken jarenlang door: op de website, in het portfolio, bij
					verkoop of publicatie. Ze laten zien hoe een ontwerp in elkaar zit en hoe het zich verhoudt
					tot zijn omgeving — met de rust en precisie die passen bij professioneel vastgoed en
					architectuur.
				</p>
			</div>
			<div class="svc-scope__apps">
				<p class="t-eyebrow svc-scope__aside-label">Toepassingen</p>
				<ul class="svc-applist">
					{toepassingen.map((t) => <li class="svc-applist__item">{t}</li>)}
				</ul>
			</div>
		</div>
	</Section>

	<!-- Werkwijze -->
	<Section as="section">
		<div class="svc-method__head">
			<p class="t-eyebrow t-eyebrow--accent">Werkwijze</p>
			<h2 class="t-h2 svc-method__title">Van standpunt tot oplevering.</h2>
		</div>
		<ol class="svc-method">
			<li class="svc-method__item u-inview">
				<span class="svc-method__num">01</span>
				<h3 class="t-h4">Voorbereiding</h3>
				<p>
					Vooraf bespreken we welke gebouwen en aanzichten in beeld moeten komen en waarvoor de
					beelden worden gebruikt. Daarop stemmen we standpunt, belichting en tijdstip af.
				</p>
			</li>
			<li class="svc-method__item u-inview" style="--reveal-index: 1">
				<span class="svc-method__num">02</span>
				<h3 class="t-h4">Op locatie</h3>
				<p>
					Rustig en nauwkeurig werken: lijnen worden rechtgezet, storende elementen waar mogelijk
					weggehaald, en waar nodig fotograferen we op hoogte voor het overzicht.
				</p>
			</li>
			<li class="svc-method__item u-inview" style="--reveal-index: 2">
				<span class="svc-method__num">03</span>
				<h3 class="t-h4">Nabewerking</h3>
				<p>
					Een zorgvuldige, terughoudende nabewerking waarin licht, kleur en perspectief kloppen — het
					gebouw blijft leidend, het beeld ondersteunt.
				</p>
			</li>
		</ol>
	</Section>

	<RelatedProjects projects={related} />

	<ContactCta
		eyebrow="Aan de slag"
		heading="Een gebouw dat gefotografeerd moet worden?"
		text="Neem vrijblijvend contact op voor een voorstel op maat van uw project."
		primaryLabel="Neem contact op"
		primaryHref="/contact/"
		secondaryLabel="Interieurfotografie"
		secondaryHref="/diensten/interieurfotografie/"
	/>
</BaseLayout>

<style>
	/* --- Intro.
	 * P4.9 (D-29) — the arch page's SIGNATURE afterglow, the COOL counterpart to the interieur page's WARM one:
	 * the Rotterdam-skyline hero directly above is a cool blue-grey sky, and its light spills a little way down
	 * across the hero→intro boundary before settling into calm reading-dark (owner Limitation 1 cross-boundary +
	 * 2 photo-light-spill; and it gives the two service pages a matched cool/warm afterglow pair — clear
	 * page-to-page variation). Same afterglow FAMILY as the homepage positionering / interieur intro (one soft
	 * top-descending light), deliberately COOL here. Peak sits off the top edge; the fringe fades to base long
	 * before the body copy, so the modelling lives in negative space, never under muted text (6.9, 6.16). --- */
	.svc-intro-sec {
		background:
			radial-gradient(
				128% 60% at 50% -14%,
				rgba(var(--p-atmos-cool), 0.16) 0%,
				rgba(var(--p-atmos-cool), 0.05) 40%,
				rgba(var(--p-atmos-cool), 0) 70%
			),
			var(--color-bg);
	}
	/* --- Intro --- */
	.svc-intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		align-items: start;
	}
	.svc-intro__lead {
		color: var(--color-text);
		max-width: none;
		font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.75rem);
		line-height: 1.4;
	}
	@media (max-width: 52rem) {
		.svc-intro {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
	}

	/* --- Representative photography (asymmetric pair: portrait + landscape) on the deep gallery surface.
	 * P4.8 CROSS-SITE (D-28): the shared "deep photography-grid chapter" gets an ACHROMATIC depth frame (vertical
	 * abyss modelling at head + foot) so the plates emerge from architectural depth rather than a flat ink wall —
	 * the same quiet-depth idiom used on the diensten spreads, always achromatic so it never tints photography
	 * (6.16). The page's colour/gold SIGNATURE lives instead on the specification wall + toepassingen below. --- */
	.svc-gallery {
		position: relative;
		isolation: isolate;
	}
	.svc-gallery::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			rgba(6, 8, 12, 0.6) 0%,
			rgba(6, 8, 12, 0) 22%,
			rgba(6, 8, 12, 0) 78%,
			rgba(6, 8, 12, 0.55) 100%
		);
	}
	.svc-gallery__label {
		display: block;
		margin-bottom: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
	}
	.svc-plates {
		display: grid;
		grid-template-columns: 0.75fr 1.25fr;
		gap: var(--space-2xl);
		align-items: end;
	}
	.svc-plate {
		min-width: 0;
	}
	.svc-plate__cap {
		margin-top: var(--space-sm);
	}
	@media (max-width: 52rem) {
		.svc-plates {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}

	/* --- Uitleg + toepassingen: an all-dark "specification wall" on the ink-850 tonal step (D-23). Statement +
	   body on the left, a precise gold-hairline toepassingen index on the right — an asymmetric grid aligned to
	   the wide representative-gallery above, so photography structures the composition. No light plane.
	 *
	 * P4.8 CROSS-SITE (D-28) — this is the arch page's SIGNATURE non-photographic premium moment. D-23's ink-850
	 * tonal step was near-imperceptible (owner Limitation 3: quiet zones read as flat). It is now MODELLED as a
	 * lit specification wall: a faint cool raking gradient over the ink-850 surface gives the wall dimensional
	 * depth (perceptible, still calm), and the toepassingen index rows gain a champagne METALLIC-EDGE TICK — a
	 * short gold catch-light leading each hairline row (6.11 "belangrijke visuele lijnen" + 6.12 controlled
	 * highlight). This is the page's distinct gold role (a precision edge on an index), NOT the homepage seam. --- */
	.svc-scope-sec {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
	}
	/* ACHROMATIC lit-wall modelling (refinement pass): a faint raked sheen at the top edge + a deepening toward
	   the abyss at the foot gives the ink-850 "specification wall" real dimensional light WITHOUT adding a cool
	   hue — so the cool *linear wall* stays reserved as the site's masthead idiom (diensten/portfolio) and this
	   page's colour signature is carried purely by the champagne gold index below (sharper per-page distinction,
	   avoids "one cool wash, three coordinates"). */
	/* P4.9 (D-29) — the D-28 lit-wall was still near-imperceptible (owner Limitation 4: quiet ≠ flat). The raked
	   achromatic sheen and the abyss foot are strengthened so the "specification wall" reads as a genuinely
	   dimensional lit surface — a clear premium NON-photographic moment — while staying ACHROMATIC (no hue, so the
	   cool linear wall stays reserved as the masthead idiom and photography is never tinted; 6.16). Still calm. */
	.svc-scope-sec::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(
			174deg,
			rgba(236, 238, 242, 0.06) 0%,
			rgba(236, 238, 242, 0.015) 22%,
			rgba(236, 238, 242, 0) 44%,
			rgba(6, 8, 12, 0.44) 100%
		);
	}
	.svc-scope {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: var(--space-2xl) clamp(var(--space-3xl), 2rem + 6vw, var(--space-4xl));
		align-items: start;
	}
	.svc-scope__title {
		margin-top: var(--space-sm);
		max-width: 15ch;
	}
	.svc-scope__body {
		margin-top: var(--space-lg);
		color: var(--color-text-secondary);
		max-width: 50ch;
	}
	/* Toepassingen — a precise architectural index: gold-accent label, hairline-ruled rows on dark. Deliberately
	   unnumbered so it stays distinct from the numbered werkwijze below. Aligned to the top of the statement. */
	.svc-scope__apps {
		padding-top: var(--space-sm);
	}
	.svc-scope__aside-label {
		color: var(--color-accent);
	}
	.svc-applist {
		margin-top: var(--space-lg);
		display: flex;
		flex-direction: column;
	}
	.svc-applist__item {
		position: relative;
		padding: var(--space-md) 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-text);
		font-weight: var(--fw-medium);
	}
	/* Champagne metallic-edge tick — a short gold catch-light leading each index row's hairline (D-28 gold role). */
	.svc-applist__item::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: clamp(1.1rem, 0.8rem + 1vw, 1.6rem);
		height: 1px;
		background: linear-gradient(90deg, rgba(224, 197, 140, 0.95) 0%, rgba(199, 165, 106, 0) 100%);
	}
	.svc-applist__item:last-child {
		border-bottom: 1px solid var(--color-border);
	}
	@media (max-width: 52rem) {
		.svc-scope {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
		.svc-scope__apps {
			padding-top: 0;
		}
	}

	/* --- Werkwijze --- */
	.svc-method__head {
		max-width: 40ch;
		margin-bottom: clamp(2rem, 1.4rem + 3vw, 3.5rem);
	}
	.svc-method__title {
		margin-top: var(--space-sm);
	}
	.svc-method {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-2xl);
	}
	.svc-method__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}
	.svc-method__num {
		font-family: var(--font-display);
		font-weight: var(--fw-display);
		font-size: clamp(2.4rem, 1.7rem + 3vw, 3.6rem);
		line-height: 1;
		color: var(--color-accent);
		letter-spacing: var(--ls-display);
		margin-bottom: var(--space-xs);
	}
	.svc-method__item p {
		color: var(--color-text-secondary);
		font-size: var(--fs-body-sm);
	}
	@media (max-width: 52rem) {
		.svc-method {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
