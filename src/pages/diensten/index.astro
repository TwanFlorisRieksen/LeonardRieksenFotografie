---
/*
 * Diensten overzicht (P4 — D-19). The navigation hub that translates visual quality into business
 * relevance (13.36) and lets a visitor tell the two disciplines apart and choose a path (13.39:
 * introductie · vergelijking · navigatiehub). NOT two equal cards — two alternating discipline "spreads"
 * with different photography, weight and emphasis. Copy transformed from Leo's own diensten page; no
 * invented facts, no commercial overstatement (13.41). Representative photography (real, PH-08 derivatives).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Media from '../../components/Media.astro';
import ContactCta from '../../components/ContactCta.astro';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const archImg = projects.find((p) => p.id === 'rotterdam-skyline-kubuswoningen');
const intImg = projects.find((p) => p.id === 'kroller-muller-paviljoen');
---

<BaseLayout
	title="Diensten"
	description="Architectuur- en interieurfotografie op locatie door Leo Rieksen. Twee disciplines, één rustige en nauwkeurige benadering — kies de dienst die bij uw project past."
>
	<!-- OPENING (P4 correction #3 — D-22). Formerly a full-bleed light "cover" band. Now dark and light coexist
	     in the opening composition: the eyebrow + display TITLE sit on a contained warm-stone plane (the "cover
	     leaf"), while the orientation text reads on the DARK page beside it. This inverts the service pages'
	     grammar (there a dark statement anchors a light elaboration; here a light title anchors a dark
	     elaboration) — the overview keeps its distinct "opens on light" identity without the full-width band,
	     and is not a generic image split hero (no photograph; asymmetric light-title / dark-text). -->
	<Section as="header" class="dien-cover">
		<div class="dien-cover__grid">
			<div class="dien-cover__lead surface-light">
				<p class="t-eyebrow t-eyebrow--accent">Diensten</p>
				<h1 class="t-display dien-title">Fotografie die het ontwerp recht doet.</h1>
			</div>
			<div class="dien-cover__body">
				<p class="t-lead dien-intro">
					Leo Rieksen is gespecialiseerd in architectuur- en interieurfotografie op locatie. Twee
					disciplines, één rustige en nauwkeurige benadering.
				</p>
				<p class="dien-cover__note">
					Elk project wordt zorgvuldig voorbereid, met veel aandacht voor licht, lijnen en sfeer —
					zodat de beelden de kwaliteit van het werk overtuigend laten zien. Kies hieronder de dienst
					die bij uw project past.
				</p>
			</div>
		</div>
	</Section>

	<!-- Two disciplines as alternating spreads (13.37/13.39) -->
	<Section as="div" width="wide" class="dien-spreads">
		{
			archImg && (
				<article class="spread spread--arch u-inview">
					<a class="spread__media-link" href="/diensten/architectuurfotografie/" tabindex="-1" aria-hidden="true">
						<Media
							src={archImg.data.coverImage}
							alt=""
							widths={[480, 800, 1200]}
							sizes="(min-width: 56rem) 55vw, 100vw"
							class="spread__media"
						/>
					</a>
					<div class="spread__text">
						<p class="t-eyebrow t-eyebrow--accent">Architectuur</p>
						<h2 class="t-h2 spread__name">Architectuurfotografie</h2>
						<p class="spread__desc">
							Gebouwen en exterieurs waarin structuur, proportie, licht en lijn samenkomen — van
							monumenten en historische gevels tot moderne architectuur en stedelijke overzichten,
							waar nodig ook op hoogte.
						</p>
						<p class="spread__for">
							Voor architecten, makelaars, bedrijven en eigenaren die hun gebouw professioneel willen
							presenteren.
						</p>
						<a class="link-arrow spread__link" href="/diensten/architectuurfotografie/">
							Bekijk architectuurfotografie
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
						</a>
					</div>
				</article>
			)
		}
		{
			intImg && (
				<article class="spread spread--int u-inview">
					<a class="spread__media-link" href="/diensten/interieurfotografie/" tabindex="-1" aria-hidden="true">
						<Media
							src={intImg.data.coverImage}
							alt=""
							widths={[480, 800, 1200]}
							sizes="(min-width: 56rem) 55vw, 100vw"
							class="spread__media"
						/>
					</a>
					<div class="spread__text">
						<p class="t-eyebrow t-eyebrow--accent">Interieur</p>
						<h2 class="t-h2 spread__name">Interieurfotografie</h2>
						<p class="spread__desc">
							Ruimtes waarin sfeer, materiaal, licht en functie tot hun recht komen — van woningen en
							kantoren tot horeca, zorginstellingen en publieke gebouwen, in bestaand en zorgvuldig
							aangevuld licht.
						</p>
						<p class="spread__for">
							Voor interieurontwerpers, makelaars en bedrijven die hun ruimtes op hun best willen
							laten zien.
						</p>
						<a class="link-arrow spread__link" href="/diensten/interieurfotografie/">
							Bekijk interieurfotografie
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
						</a>
					</div>
				</article>
			)
		}
	</Section>

	<ContactCta
		heading="Een project in gedachten?"
		text="Neem contact op om kort door te spreken wat u zoekt. Op basis daarvan maak ik een passend voorstel."
		primaryLabel="Neem contact op"
		primaryHref="/contact/"
		secondaryLabel="Bekijk het portfolio"
		secondaryHref="/portfolio/"
	/>
</BaseLayout>

<style>
	/* --- Opening: contained light title plane (left) + dark orientation text (right) --- */
	.dien-cover__grid {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		align-items: end;
	}
	/* The title "cover leaf" — a contained warm-stone plane holding the display title. On desktop the grid
	   already contains it to the left column with the dark orientation text on the right; no radius/shadow. */
	.dien-cover__lead {
		padding: clamp(1.75rem, 1.2rem + 2.8vw, 3.5rem);
	}
	.dien-title {
		margin-top: var(--space-sm);
		max-width: 15ch;
	}
	.dien-cover__body {
		padding-bottom: var(--space-md);
	}
	.dien-intro {
		max-width: 40ch;
		color: var(--color-text);
	}
	.dien-cover__note {
		margin-top: var(--space-lg);
		max-width: 46ch;
		color: var(--color-text-secondary);
		font-size: var(--fs-body-sm);
	}
	@media (max-width: 56rem) {
		.dien-cover__grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
			align-items: start;
		}
		/* Mobile: the title leaf bleeds to the LEFT screen edge with a dark inset on the right — an offset
		   register, not a full-width light slab (reliable at narrow widths where the container has no auto-margin). */
		.dien-cover__lead {
			margin-left: calc(-1 * var(--gutter));
			margin-right: var(--space-xl);
			padding-left: max(var(--gutter), clamp(1.75rem, 1.2rem + 2.8vw, 3.5rem));
		}
		.dien-title {
			max-width: 18ch;
		}
	}
	@media (max-width: 30rem) {
		.dien-cover__lead {
			margin-right: var(--space-md);
		}
	}

	/* --- Alternating discipline spreads --- */
	.dien-spreads :global(.u-container) {
		display: flex;
		flex-direction: column;
		gap: clamp(3.5rem, 2rem + 7vw, 7rem);
	}
	.spread {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		align-items: center;
	}
	/* Interior spread reverses — text left, image right — so the page reads as a comparison, not a list. */
	.spread--int {
		grid-template-columns: 1fr 1.25fr;
	}
	.spread--int .spread__media-link {
		order: 2;
	}
	.spread__media-link {
		display: block;
	}
	.spread__name {
		margin-block: var(--space-xs) var(--space-md);
	}
	.spread__desc {
		color: var(--color-text-secondary);
		max-width: 44ch;
	}
	.spread__for {
		margin-top: var(--space-md);
		color: var(--color-text-muted);
		font-size: var(--fs-body-sm);
		max-width: 40ch;
	}
	.spread__link {
		margin-top: var(--space-lg);
	}
	@media (max-width: 56rem) {
		.spread,
		.spread--int {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
		.spread--int .spread__media-link {
			order: 0;
		}
	}
</style>
