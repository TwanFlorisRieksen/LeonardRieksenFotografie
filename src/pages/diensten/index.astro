---
/*
 * Diensten overzicht (P4 — D-19). The navigation hub that translates visual quality into business
 * relevance (13.36) and lets a visitor tell the two disciplines apart and choose a path (13.39:
 * introductie · vergelijking · navigatiehub). NOT two equal cards — two alternating discipline "spreads"
 * with different photography, weight and emphasis. Copy transformed from Leo's own diensten page; no
 * invented facts, no commercial overstatement (13.41). Representative photography (real, PH-08 derivatives).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Media from '../../components/Media.astro';
import ContactCta from '../../components/ContactCta.astro';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const archImg = projects.find((p) => p.id === 'rotterdam-skyline-kubuswoningen');
const intImg = projects.find((p) => p.id === 'kroller-muller-paviljoen');
---

<BaseLayout
	title="Diensten"
	description="Architectuur- en interieurfotografie op locatie door Leo Rieksen. Twee disciplines, één rustige en nauwkeurige benadering — kies de dienst die bij uw project past."
>
	<!-- OPENING (P4 correction #4 — D-23). The light "cover leaf" is retired. The overview keeps its distinct
	     "editorial masthead" identity — but on dark: an eyebrow across the top, then a monumental display title
	     baseline-aligned against the orientation text, opening with generous negative space (13.36/13.39). No
	     photograph (that distinguishes it from the home hero and the service heroes), no light panel — the scale
	     contrast of the display title and the calm dark field carry the open; the discipline photography follows. -->
	<Section as="header" class="dien-cover">
		<div class="dien-cover__marker">
			<span class="dien-cover__rule" aria-hidden="true"></span>
			<p class="t-eyebrow t-eyebrow--accent dien-cover__eyebrow">Diensten</p>
		</div>
		<div class="dien-cover__grid">
			<h1 class="t-display dien-title">Fotografie die het ontwerp recht doet.</h1>
			<div class="dien-cover__body">
				<p class="t-lead dien-intro">
					Leo Rieksen is gespecialiseerd in architectuur- en interieurfotografie op locatie. Twee
					disciplines, één rustige en nauwkeurige benadering.
				</p>
				<p class="dien-cover__note">
					Elk project wordt zorgvuldig voorbereid, met veel aandacht voor licht, lijnen en sfeer —
					zodat de beelden de kwaliteit van het werk overtuigend laten zien. Kies hieronder de dienst
					die bij uw project past.
				</p>
			</div>
		</div>
	</Section>

	<!-- Two disciplines as alternating spreads (13.37/13.39). Stepped onto the deepest surface (ink-950, 6.9) so
	     the two large discipline PHOTOGRAPHS read as a gallery wall — the visual energy of the page — tonally
	     separated from the dark masthead above and the base-dark CTA below (D-23 dark tonal rhythm, no light). -->
	<Section as="div" surface="deep" width="wide" class="dien-spreads">
		{
			archImg && (
				<article class="spread spread--arch u-inview">
					<a class="spread__media-link" href="/diensten/architectuurfotografie/" tabindex="-1" aria-hidden="true">
						<Media
							src={archImg.data.coverImage}
							alt=""
							widths={[480, 800, 1200]}
							sizes="(min-width: 56rem) 55vw, 100vw"
							class="spread__media"
						/>
					</a>
					<div class="spread__text">
						<p class="t-eyebrow t-eyebrow--accent">Architectuur</p>
						<h2 class="t-h2 spread__name">Architectuurfotografie</h2>
						<p class="spread__desc">
							Gebouwen en exterieurs waarin structuur, proportie, licht en lijn samenkomen — van
							monumenten en historische gevels tot moderne architectuur en stedelijke overzichten,
							waar nodig ook op hoogte.
						</p>
						<p class="spread__for">
							Voor architecten, makelaars, bedrijven en eigenaren die hun gebouw professioneel willen
							presenteren.
						</p>
						<a class="link-arrow spread__link" href="/diensten/architectuurfotografie/">
							Bekijk architectuurfotografie
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
						</a>
					</div>
				</article>
			)
		}
		{
			intImg && (
				<article class="spread spread--int u-inview">
					<a class="spread__media-link" href="/diensten/interieurfotografie/" tabindex="-1" aria-hidden="true">
						<Media
							src={intImg.data.coverImage}
							alt=""
							widths={[480, 800, 1200]}
							sizes="(min-width: 56rem) 55vw, 100vw"
							class="spread__media"
						/>
					</a>
					<div class="spread__text">
						<p class="t-eyebrow t-eyebrow--accent">Interieur</p>
						<h2 class="t-h2 spread__name">Interieurfotografie</h2>
						<p class="spread__desc">
							Ruimtes waarin sfeer, materiaal, licht en functie tot hun recht komen — van woningen en
							kantoren tot horeca, zorginstellingen en publieke gebouwen, in bestaand en zorgvuldig
							aangevuld licht.
						</p>
						<p class="spread__for">
							Voor interieurontwerpers, makelaars en bedrijven die hun ruimtes op hun best willen
							laten zien.
						</p>
						<a class="link-arrow spread__link" href="/diensten/interieurfotografie/">
							Bekijk interieurfotografie
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
						</a>
					</div>
				</article>
			)
		}
	</Section>

	<ContactCta
		heading="Een project in gedachten?"
		text="Neem contact op om kort door te spreken wat u zoekt. Op basis daarvan maak ik een passend voorstel."
		primaryLabel="Neem contact op"
		primaryHref="/contact/"
		secondaryLabel="Bekijk het portfolio"
		secondaryHref="/portfolio/"
	/>
</BaseLayout>

<style>
	/* --- Opening: a dark editorial masthead — eyebrow across the top, monumental display title baseline-aligned
	   against the orientation text. Generous top space for a calm premium open (D-23).
	 *
	 * P4.8 CROSS-SITE (D-28) — this type-only masthead is the diensten page's signature NON-PHOTOGRAPHIC premium
	 * moment (the owner's Limitation 3: quiet zones must still feel luxurious). Two mechanisms, neither a soft
	 * radial bubble:
	 *   1. TONAL WALL — a large-scale *linear* graded field (cool light raked from the top edge + a faint lift
	 *      into the empty upper-right negative space), so the monumental Archivo type sits against modelled
	 *      architectural depth instead of dead flat black. Linear/directional = perceptually distinct from the
	 *      homepage's afterglow *radial*.
	 *   2. A GOLD DATUM RULE — a short champagne hairline that catches a highlight toward the eyebrow, like an
	 *      architect's dimension/datum marker (6.11 "belangrijke visuele lijnen", 6.12 controlled highlight). A
	 *      selective structural line FRAGMENT — deliberately NOT the homepage's full-width `.work` seam. --- */
	.dien-cover {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		padding-top: clamp(2rem, 1rem + 5vw, 5rem);
		background:
			linear-gradient(
				180deg,
				rgba(var(--p-atmos-cool), 0.13) 0%,
				rgba(var(--p-atmos-cool), 0.04) 30%,
				rgba(var(--p-atmos-cool), 0) 58%
			),
			linear-gradient(255deg, rgba(var(--p-atmos-cool), 0.07) 0%, rgba(var(--p-atmos-cool), 0) 44%),
			var(--color-bg);
	}
	.dien-cover__marker {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin-bottom: clamp(1.5rem, 1rem + 2.5vw, 3rem);
	}
	/* P4.9 (D-29) — the short horizontal datum rule is extended into an architect's L-bracket by a thin vertical
	   gold riser dropping from the same top-left corner into the negative space above the monumental title (owner
	   Limitation 3: gold gains larger spatial extent while staying a 1px hairline — extent, not weight). A longer
	   structural trace, distinct from the homepage glow-seam and from the short project/CTA datum rules. Sits in
	   the gap above the title, clear of the type; aria-hidden decorative (pure ::before, not announced). */
	.dien-cover__marker::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 1px;
		height: clamp(4.5rem, 3rem + 4vw, 8rem);
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			rgba(224, 197, 140, 0.7) 0%,
			rgba(199, 165, 106, 0.22) 44%,
			rgba(199, 165, 106, 0) 100%
		);
	}
	.dien-cover__rule {
		flex: none;
		width: clamp(2rem, 1.4rem + 2vw, 3.25rem);
		height: 1px;
		background: linear-gradient(
			90deg,
			rgba(199, 165, 106, 0) 0%,
			rgba(199, 165, 106, 0.5) 34%,
			rgba(224, 197, 140, 0.92) 100%
		);
	}
	.dien-cover__grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: var(--space-2xl) clamp(var(--space-3xl), 2rem + 5vw, var(--space-4xl));
		align-items: end;
	}
	.dien-title {
		max-width: 15ch;
	}
	.dien-cover__body {
		padding-bottom: var(--space-sm);
	}
	.dien-intro {
		max-width: 40ch;
		color: var(--color-text);
	}
	.dien-cover__note {
		margin-top: var(--space-lg);
		max-width: 46ch;
		color: var(--color-text-secondary);
		font-size: var(--fs-body-sm);
	}
	@media (max-width: 56rem) {
		.dien-cover__grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
			align-items: start;
		}
		.dien-title {
			max-width: 18ch;
		}
	}

	/* --- Alternating discipline spreads.
	 * P4.8 (D-28): an ACHROMATIC depth field (no chroma, so it never tints the two discipline photographs — 6.16).
	 * The already-deep surface (ink-950) is modelled toward the true abyss at its top and foot, so the two large
	 * photographs read as emerging from architectural depth rather than sitting on a flat wall. Deliberately NOT a
	 * colour pool (that is the homepage specialisaties mechanism — kept unique) and NOT a bubble; a vertical tonal
	 * frame, the calm counterpart to the loud masthead above. --- */
	.dien-spreads {
		position: relative;
		isolation: isolate;
		/* P4.10 TRUE BOUNDARY CROSSING (D-30) — the masthead above is a type-only field (cool wall, rgb(15,19,26))
		   with a large empty band below the title; the spreads below are the deeper gallery field (ink-950,
		   rgb(9,11,15)). Rather than the two meeting at a clean horizontal cut, the FIRST discipline photograph
		   physically rises ACROSS that boundary into the masthead's empty lower band — a real content crossing
		   (owner's cited portfolio-lead model, varied: here a landscape photo straddling a TYPE masthead). The
		   two fields stay clearly distinct (visibly different bg); the photo layers over the seam. Robust: the
		   spreads keep their own bg start (boundary fixed), only the first spread's flow rises via a negative
		   margin into reserved space; painting-above is automatic (later DOM + this section's `isolation`).
		   ROBUSTNESS (P5.1 — D-32): the reduced top padding MUST be compounded onto `.section` (`.dien-spreads.section`,
		   specificity 0,3,0) so it deterministically beats Section.astro's `.section { padding-block }` shorthand
		   (0,2,0). Without this, production CSS source-order let the shorthand win — top padding resolved to the full
		   `--section-gap` (~120px) and the photo dropped ~18px BELOW the seam, leaving the masthead's band empty
		   (the crossing "no longer visibly crossed"). This is a specificity guarantee, not source-order luck. */
		--cross-rise: clamp(3rem, 1rem + 6vw, 7rem);
	}
	.dien-spreads.section {
		padding-top: clamp(1.5rem, 0.5rem + 2vw, 3rem);
	}
	.dien-spreads::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(
			180deg,
			rgba(6, 8, 12, 0.6) 0%,
			rgba(6, 8, 12, 0) 20%,
			rgba(6, 8, 12, 0) 80%,
			rgba(6, 8, 12, 0.55) 100%
		);
	}
	.dien-spreads :global(.u-container) {
		display: flex;
		flex-direction: column;
		gap: clamp(3.5rem, 2rem + 7vw, 7rem);
	}
	.spread {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		align-items: center;
	}
	/* The first spread rises across the masthead boundary (its photograph straddles the two fields). The
	   whole first spread lifts so the photo leads into the masthead's empty band while its text settles just
	   below the seam on the deep field — a coherent, layered open, not a decorative overlap. */
	.spread--arch {
		margin-top: calc(-1 * var(--cross-rise));
	}
	/* Interior spread reverses — text left, image right — so the page reads as a comparison, not a list. */
	.spread--int {
		grid-template-columns: 1fr 1.25fr;
	}
	.spread--int .spread__media-link {
		order: 2;
	}
	.spread__media-link {
		display: block;
	}
	.spread__name {
		margin-block: var(--space-xs) var(--space-md);
	}
	.spread__desc {
		color: var(--color-text-secondary);
		max-width: 44ch;
	}
	.spread__for {
		margin-top: var(--space-md);
		color: var(--color-text-muted);
		font-size: var(--fs-body-sm);
		max-width: 40ch;
	}
	.spread__link {
		margin-top: var(--space-lg);
	}
	@media (max-width: 56rem) {
		.spread,
		.spread--int {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
		.spread--int .spread__media-link {
			order: 0;
		}
		/* Mobile stacks the spread (photo over text); the boundary crossing is a desktop composition move only —
		   restore normal top spacing so the masthead and the first photo don't collide in the single column.
		   Compounded onto `.section` (0,3,0) so this reset still beats the desktop `.dien-spreads.section` override
		   above (equal specificity → later source order wins) — mobile keeps full `--section-gap` breathing room. */
		.dien-spreads.section {
			padding-top: var(--section-gap);
		}
		.spread--arch {
			margin-top: 0;
		}
	}
</style>
