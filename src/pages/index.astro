	<!-- ============================================================================================= *
	     P6.2 RECOVERY, HOMEPAGE REALTIME INTERACTION RUNTIME (D-38).
	     One small unified `is:inline` runtime (emits NO JS bundle; the site stays 0-bundle) providing the
	     realtime, input-driven feedback the owner asked for, VARIED families, not one copied effect:
	       · scroll-direction / scrolled signal  → data-attrs + class on <html> (a cheap signal, drives CSS).
	       · [data-plight]   pointer light        → writes --gx/--gy (generalised catch-light).
	       · [data-ptilt]    pointer parallax+light→ the inner photo eases TOWARD the pointer within its clip
	                                                 (a DIFFERENT photography response than the plate's light),
	                                                 with lerp inertia + a tracking light.
	       · [data-magnetic] magnetic pull        → element eases toward the pointer, springs back on leave.
	     Pointer families attach ONLY on a fine desktop pointer with motion allowed (touch / no-JS /
	     reduced-motion → simply absent, composition fully intact). Every loop is rAF-throttled, passive and
	     SELF-HALTING (stops when settled) so there is no permanent animation. Writes custom properties only
	     (no layout reads in the loop), compositor-friendly. -->
	<script is:inline>
		(function () {
			var docEl = document.documentElement;
			var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// --- Scroll-state signal (always on; a signal, not motion, drives CSS transitions only) ---
			// P9 (D-80): `lastY` is seeded INSIDE the first frame, not at parse time. This script sits in the
			// middle of the document (it has to: it binds handlers to elements above it), and reading
			// window.scrollY there forced a synchronous layout of everything parsed so far, measured at 97 ms
			// of the homepage's 134 ms of forced reflow on a 4×-throttled load, in the middle of parsing. The
			// value is identical a frame later, and a rAF callback still runs before the first paint, so the
			// scroll state is just as correct and the parser is never interrupted.
			var lastY = 0,
				dir = '',
				ticking = false;
			function onScroll() {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(function () {
					var y = window.scrollY;
					var d = y > lastY + 2 ? 'down' : y < lastY - 2 ? 'up' : dir;
					if (d !== dir) {
						dir = d;
						docEl.dataset.scrollDir = d;
					}
					docEl.classList.toggle('is-scrolled', y > 8);
					lastY = y;
					ticking = false;
				});
			}
			window.addEventListener('scroll', onScroll, { passive: true });
			requestAnimationFrame(function () {
				lastY = window.scrollY;
				onScroll();
			});

			var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
			if (!fine || reduce) return; // pointer families are enhancement only

			// --- Pointer light (generalised catch-light): write --gx/--gy on the host; children inherit. ---
			document.querySelectorAll('[data-plight]').forEach(function (host) {
				var raf = 0,
					gx = 50,
					gy = 40;
				host.addEventListener(
					'pointermove',
					function (e) {
						var r = host.getBoundingClientRect();
						gx = ((e.clientX - r.left) / r.width) * 100;
						gy = ((e.clientY - r.top) / r.height) * 100;
						if (!raf)
							raf = requestAnimationFrame(function () {
								raf = 0;
								host.style.setProperty('--gx', gx.toFixed(1) + '%');
								host.style.setProperty('--gy', gy.toFixed(1) + '%');
							});
					},
					{ passive: true }
				);
			});

			// --- Pointer parallax + light on photography: the photo eases toward the pointer (lerp). ---
			document.querySelectorAll('[data-ptilt]').forEach(function (host) {
				var img = host.querySelector('img');
				var amt = parseFloat(host.dataset.ptilt) || 8;
				var tx = 0, ty = 0, cx = 0, cy = 0, gx = 50, gy = 40, cgx = 50, cgy = 40;
				var raf = 0, over = false;
				function loop() {
					cx += (tx - cx) * 0.11;
					cy += (ty - cy) * 0.11;
					cgx += (gx - cgx) * 0.11;
					cgy += (gy - cgy) * 0.11;
					if (img) {
						img.style.setProperty('--ptx', cx.toFixed(2) + 'px');
						img.style.setProperty('--pty', cy.toFixed(2) + 'px');
					}
					host.style.setProperty('--gx', cgx.toFixed(1) + '%');
					host.style.setProperty('--gy', cgy.toFixed(1) + '%');
					var settled = Math.abs(tx - cx) < 0.05 && Math.abs(ty - cy) < 0.05 && Math.abs(gx - cgx) < 0.05;
					if (over || !settled) raf = requestAnimationFrame(loop);
					else raf = 0;
				}
				host.addEventListener(
					'pointermove',
					function (e) {
						var r = host.getBoundingClientRect();
						var nx = (e.clientX - r.left) / r.width - 0.5;
						var ny = (e.clientY - r.top) / r.height - 0.5;
						tx = nx * amt * 2;
						ty = ny * amt * 2;
						gx = 50 + nx * 100;
						gy = 50 + ny * 100;
						over = true;
						if (!raf) raf = requestAnimationFrame(loop);
					},
					{ passive: true }
				);
				host.addEventListener('pointerleave', function () {
					tx = ty = 0;
					gx = 50;
					gy = 40;
					over = false;
					if (!raf) raf = requestAnimationFrame(loop);
				});
			});

			// --- Magnetic pull (hero CTA only): eases toward the pointer, springs back on leave. ---
			document.querySelectorAll('[data-magnetic]').forEach(function (el) {
				var pull = parseFloat(el.dataset.magnetic) || 9;
				var tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, over = false;
				function loop() {
					cx += (tx - cx) * 0.2;
					cy += (ty - cy) * 0.2;
					el.style.setProperty('--mx', cx.toFixed(2) + 'px');
					el.style.setProperty('--my', cy.toFixed(2) + 'px');
					if (over || Math.abs(tx - cx) > 0.05 || Math.abs(ty - cy) > 0.05) raf = requestAnimationFrame(loop);
					else raf = 0;
				}
				el.addEventListener(
					'pointermove',
					function (e) {
						var r = el.getBoundingClientRect();
						tx = ((e.clientX - (r.left + r.width / 2)) / (r.width / 2)) * pull;
						ty = ((e.clientY - (r.top + r.height / 2)) / (r.height / 2)) * pull;
						over = true;
						if (!raf) raf = requestAnimationFrame(loop);
					},
					{ passive: true }
				);
				el.addEventListener('pointerleave', function () {
					tx = ty = 0;
					over = false;
					if (!raf) raf = requestAnimationFrame(loop);
				});
			});
		})();
	</script>

