---
/*
 * Homepage (P4, D-19). The brand + conversion experience, not a section checklist. Built on the proven
 * P2/P3 foundation (nocturne tokens, Archivo/Instrument Sans, Media pipeline, shared shell). Concept: a
 * "dark architectural monograph", a full-bleed photographic hero, then a small number of asymmetric
 * editorial beats connected by gold hairlines and carried by monumental Archivo scale-contrast. The
 * blueprint's 10-beat recommended flow (13.13) is deliberately consolidated into fewer, stronger sections
 * (progressive disclosure, 13.12): hero → positionering+Leo → geselecteerd werk → specialisaties →
 * werkwijze → contact. Photography structures the page; the interface recedes (2.2 fotografie-first).
 *
 * Content authority (CLAUDE §9.2): the hero line, positioning prose and working-method copy are
 * TRANSFORMED from Leo's own current site (reference/old-website index.html + diensten.html + site-text.json);
 * no business facts are invented. Bio "owner-confirm" facts (experience/HDR/long-exposure/education) are
 * deliberately NOT asserted here (D-19 content audit). Photography is real, selected by visual inspection
 * (CLAUDE §9.3), byte-identical to the /assets masters (served as derivatives, PH-08).
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Media from '../components/Media.astro';
import ContactCta from '../components/ContactCta.astro';
import heroImg from '../assets/static/hero.jpeg';
import amersfoortImg from '../assets/static/amersfoort-toren.jpg';
import eemhuisImg from '../assets/static/eemhuis-bibliotheek.jpg';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order
);
const selected = projects.slice(0, 3);
const [featured, ...secondary] = selected;
const categoryLabel: Record<string, string> = { architectuur: 'Architectuur', interieur: 'Interieur' };

// SEO-06 / image protection (D-09): og:image MUST be an optimized derivative, never `heroImg.src`
// (the raw source master, the PH-08 gate correctly fails that). Width 1200 = standard OG; no fixed crop.
const ogImage = await getImage({ src: heroImg, width: 1200, format: 'jpeg' });
---

<BaseLayout
	title="Architectuur- & interieurfotografie"
	description="Leo Rieksen fotografeert architectuur en interieurs met rust, precisie en perfect licht, voor architecten, interieurontwerpers, makelaars en bedrijven in Midden-Nederland."
	socialImage={ogImage.src}
	heroHeader
>
	<!-- ============================================================================================= *
	     THE DESCENDING ENVIRONMENT (P6.2 / D-41). One continuous sky the reader falls THROUGH, a genuinely
	     visible (chromatic but dark) dusk that evolves blue-hour → deep night → warm interior night as you
	     descend, with a horizon that rises past the camera and atmospheric haze for depth. home-cinema.js
	     drives each layer's OPACITY + TRANSFORM continuously from scroll ALTITUDE (compositor-only, no
	     per-frame gradient repaint, CLS-safe), so the world is always exactly where the camera is. This is
	     the visible connective tissue that the D-40 low-alpha whisper failed to be (owner: still felt like
	     stacked sections). Bold in the negative space, HIDDEN behind full-bleed photography, so the
	     photographs stay dominant. aria-hidden: purely atmospheric, never content. Off (opacity 0) until
	     `html.motion-scene`; under no-JS / reduced motion it stays invisible and the honest stacked
	     composition (per-section atmospheres) renders instead. Layer order = paint order (back → front):
	     deep-night base · blue-hour · warm-interior · horizon glow · haze · vignette. -->
	<div class="stage" aria-hidden="true">
		<div class="stage__sky stage__sky--b"></div>
		<div class="stage__sky stage__sky--a"></div>
		<div class="stage__sky stage__sky--c"></div>
		<div class="stage__horizon"></div>
		<div class="stage__haze"></div>
		<div class="stage__vignette"></div>
	</div>

	<!-- HERO, the first large contact moment (13.14). Photography full-bleed and central; identity,
	     positioning and one logical next step over it; no competing CTAs or long text (13.16). -->
	<header class="home-hero">
		<Media
			src={heroImg}
			alt="De Reitdiephaven in Groningen tijdens het blauwe uur, kleurrijke houten woningen weerspiegeld in stil water."
			priority={true}
			widths={[640, 1024, 1400, 1920]}
			sizes="100vw"
			class="home-hero__media u-parallax"
			data-ptilt="11"
		/>
		<div class="home-hero__scrim"></div>
		<!-- The establishing shot's continuous life (P6.2 / D-40). A whisper-soft warm light that lives over the
		     water's reflection zone, an amplification of the photograph's OWN reflected window-lights, which in a
		     real long exposure shimmer on still water. home-cinema.js slowly drifts + breathes it (~11s), so the
		     hero keeps a cinematic presence after 10s at rest without any busy animation. opacity 0 by default
		     (no-JS / reduced motion → simply absent); screen-blended, confined to the lower water band, never over
		     the buildings or text; purely atmospheric. -->
		<div class="home-hero__lumen" aria-hidden="true"></div>
		<!-- The night the camera descends through (P6.2 refinement of D-41). A band of deep night that
		     home-cinema.js TRANSLATES, never fades, from below the frame, up through the photograph (still
		     water first, then the houses, then its blue-hour sky) and onward past the camera, uncovering the
		     open stage sky behind it. The photograph is handed over to the sky underneath it at the one instant
		     the band covers the frame completely, so it is never seen to leave: it is consumed by the
		     descending world rather than dimmed (owner: "it should transform... do NOT solve this with
		     opacity"). Parked below the frame by a CSS transform at rest, so no-JS / reduced motion never see
		     it and the honest hero stays intact. -->
		<div class="home-hero__dusk" aria-hidden="true"></div>
		<!-- The arrival (P6.2 refinement). Two layers of night that lift on the first painted frame, weighted
		     so the light returns to the reflection first and the sky last, the world resolves itself in the
		     order the photograph wants, before any typography exists (owner note #2: "nothing memorable
		     happens"). Pure CSS on purpose: it must not wait for, or depend on, the GSAP bundle. Both rest at
		     opacity 0 and reduced motion excludes them, so a veil can never be left over the photograph. -->
		<div class="home-hero__enter" aria-hidden="true"></div>
		<!-- ── THE CAPTION COLUMN (P8.6 / D-77, the hero recomposed, again) ─────────────────────────────
		     THE VERDICT ON D-76: "de huidige hero is rustiger geworden maar de compositie voelt niet
		     premium." Both halves of that are correct, and the second one is a composition problem that
		     smaller type cannot reach (the brief says so explicitly: "niet simpelweg tekst verkleinen").

		     WHAT D-76's TITLE CARD ACTUALLY WAS, MEASURED. A ROW spanning the full container width, title
		     left, lead and action right, one baseline band, under a full-width champagne datum. Three
		     things follow from "full width", and all three are the opposite of editorial:
		       · a rule drawn from edge to edge across a photograph is a BANNER. It cuts the picture in half
		         horizontally at the exact place the eye wants to travel;
		       · a block that occupies 100% of the width has no asymmetry available to it. Left mass plus
		         right mass filling the frame is a bar, however unequal the two columns are;
		       · and it takes the whole foot of the photograph, so the "more whitespace" the brief asks for
		         has nowhere to come from.

		     WHERE THE NEW BLOCK GOES IS READ OFF THE PHOTOGRAPH, NOT CHOSEN. Sampling the hero's own
		     luminance on a 6×5 grid at 1440×900, with the scrim removed (mean / brightest per cell):

		            x→        0-240   240-480  480-720  720-960  960-1200 1200-1440
		         y 720-900     90/144   79/123   67/250   47/236   28/65    21/48

		     The bottom-right quadrant is the quietest region of the entire frame by a wide margin, mean
		     luminance 21–28 against 67–90 on the left, and a brightest pixel of 48–65 where the left carries
		     236–250 (the reflected window-lights). The coloured houses, the tower and every reflection Leo
		     photographed are elsewhere. So the type goes there: it is the one place on this frame where a
		     block of words costs the photograph almost nothing and needs almost no scrim to be legible.

		     THE COMPOSITION. One narrow COLUMN in the lower right, datum, eyebrow, title, lead, action,
		     stacked in a single measure, floating clear of both the bottom and the right edge. Not a band:
		     a caption block, the idiom an architecture monograph actually uses. What this buys, in order of
		     the brief's own list:
		       · fotografie centraal, the left 62% and the upper 55% of the frame are now uninterrupted
		         photograph, including the entire subject;
		       · editorial compositie, a column of type in a wide frame, set against the picture rather
		         than laid across it;
		       · elegante asymmetrie, the block is off-axis in BOTH directions, and it is answered
		         diagonally by the navigation at the top right and by the scroll cue, which moves from the
		         centre to the opposite gutter so the foot of the frame is a diagonal rather than a row;
		       · meer witruimte, the block occupies ~143k px² where the card occupied ~317k, a 55% cut,
		         and the space it releases is contiguous rather than scattered;
		       · betere verhouding tekst/foto, the h1 falls to a 3-line column in its own measure. That is
		         a consequence of the column, exactly as D-76's 2-line fall was a consequence of the row.
		     The reveal is unchanged in kind: `u-reveal` moves onto the column's lines, the four
		     `--reveal-index` values and all four camera-curve timings survive, and the datum still draws
		     itself first. -->
		<!-- ── (D-76's title card, superseded, kept for the reasoning that still holds) ──────────────────
		     WHAT WAS WRONG, MEASURED. The h1 rendered at 100px over three lines in a 920px block starting at
		     y=281 of a 900px viewport: the typography occupied the entire left half of the frame, from the
		     sky down to the water, and the photograph's actual subject, the coloured houses of the
		     Reitdiephaven and their reflection, was underneath it. On a site whose first principle is that
		     photography is the product and the interface recedes (2.2 / 6.16), the single most important
		     screen was the one place that principle was reversed.

		     WHY IT IS NOT "SMALLER FONTS" (the brief rules that out explicitly, and it would not have worked
		     anyway: at 3 lines a smaller h1 is still a wall, just a quieter one). The composition changes:
		       · the type leaves the middle of the frame and becomes a LOWER-BAND TITLE CARD. The whole upper
		         two-thirds, sky, houses, masts, is now uninterrupted photograph;
		       · it stops being a STACK and becomes a ROW. Title left, supporting line and action right, on
		         one baseline band. A stack grows downward and takes height from the image; a row spends the
		         width the composition already had and takes almost none. This is what actually buys the
		         photograph its frame back, and it is why the h1 only needs to fall to two lines rather than
		         to something apologetic;
		       · a champagne DATUM hairline draws across the top of the card, so the type sits under a real
		         structural line instead of floating on the water. It is the site's own datum idiom (the
		         header, the footer and the CTA close all carry the same mark), which is what makes this read
		         as the brand's hero rather than as a generic photo-with-caption;
		       · and the SCRIM is re-weighted (see `.home-hero__scrim`), from a corner wash that darkened the
		         left half of the picture to a foot band that darkens only the water the card sits on.
		     The reveal is unchanged in kind, `u-reveal` now sits on the two columns rather than on the flat
		     stack, so the eyebrow → title → line → action order and all four camera-curve timings survive. -->
		<div class="home-hero__content u-container u-container--wide">
			<div class="home-hero__card">
				<span class="home-hero__datum" aria-hidden="true"></span>
				<div class="home-hero__lines u-reveal">
					<p class="t-eyebrow t-eyebrow--accent" style="--reveal-index: 0">
						Architectuur- &amp; interieurfotografie
					</p>
					<h1 class="t-display home-hero__title u-reveal-mask" style="--reveal-index: 1">
						Fotografie met rust, precisie en perfect licht.
					</h1>
					<p class="t-lead home-hero__sub" style="--reveal-index: 2">
						Leo Rieksen legt gebouwen en interieurs vast met oog voor sfeer, lijnen en belichting, van
						het blauwe uur tot zorgvuldig opgebouwd kunstlicht.
					</p>
					<div class="home-hero__actions" style="--reveal-index: 3">
						<a class="home-hero__cta" href="/portfolio/" data-magnetic="8">
							Bekijk het portfolio
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								focusable="false"
							>
								<path d="M4 12h15M13 6l6 6-6 6" />
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
		<a class="home-hero__scroll" href="#positionering" aria-label="Verder naar de introductie">
			<span></span>
		</a>
	</header>

	<!-- POSITIONERING + INTRODUCTIE LEO (13.17 / 13.20). Asymmetric: a monumental statement against the
	     transformed intro prose + a brief, factual introduction of Leo. Progressive disclosure, the full
	     background lives on Over mij. -->
	<Section as="section" id="positionering" class="pos-sec">
		<div class="pos">
			<div class="pos__lead">
				<p class="t-eyebrow t-eyebrow--accent">Positionering</p>
				<h2 class="t-display pos__statement u-mask-up">Architectuur en interieur in balans.</h2>
			</div>
			<div class="pos__body u-settle">
				<p class="t-lead pos__intro">
					Een goed gebouw of interieur is zorgvuldig ontworpen. De fotografie moet dat verhaal
					versterken, niet verstoren.
				</p>
				<p>
					Leo werkt rustig, nauwkeurig en in goed overleg met de opdrachtgever, met aandacht voor
					het beste moment van de dag, de juiste invalshoeken en de belichting. Het resultaat: strakke,
					rustige beelden met veel oog voor licht, lijnen en materiaal.
				</p>
				<p class="pos__audience">
					Beelden voor architecten, interieurontwerpers, makelaars en bedrijven die hun ruimtes
					professioneel willen laten zien, in Midden-Nederland en daarbuiten.
				</p>
				<p class="pos__more">
					<a class="link-arrow" href="/over-mij/">
						Maak kennis met Leo
						<svg
							width="17"
							height="17"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							focusable="false"
						>
							<path d="M4 12h15M13 6l6 6-6 6" />
						</svg>
					</a>
				</p>
			</div>
		</div>
	</Section>

	<!-- GESELECTEERD WERK (13.18). A curated glimpse, not the full portfolio, one large featured plate
	     beside a stacked pair, each opening its project. Composed as an editorial spread (distinct from the
	     portfolio overview's own lead+index layout) so the two pages don't share a structure. Stepped onto
	     the DEEPEST surface (ink-950, blueprint 6.9) so the work reads as a distinct gallery chapter, tonally
	     separated from the positionering above, a dark-scale boundary, not a light insert. -->
	<Section as="section" surface="deep" width="flush" class="work">
		<div class="u-container work__head">
			<div>
				<p class="t-eyebrow t-eyebrow--accent">Geselecteerd werk</p>
				<h2 class="t-h2 work__title">Elk project als geheel gefotografeerd.</h2>
			</div>
			<a class="link-arrow work__all" href="/portfolio/">
				Volledig portfolio
				<svg
					width="17"
					height="17"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M4 12h15M13 6l6 6-6 6" />
				</svg>
			</a>
		</div>

		{
			/* THE BIG IMAGE MOMENT (P4.5). The featured project reprises the hero's immersive full-bleed
			   grammar, the first container break since the hero, so photography regains commanding scale
			   and the interface recedes (blueprint 4.58 "grote beeldmomenten", 8.3 scale/negative-space). It
			   is revealed by the geometric image mask (`u-inview--mask`), the loud counterpart to the calm
			   text rise used elsewhere. Static-first: a plain <a> with a real caption; the mask only enhances. */
		}
		{
			featured && (
				<a class="work-immersive u-inview" href={`/portfolio/${featured.id}/`} data-plight>
					<Media
						src={featured.data.coverImage}
						alt={featured.data.coverImageAlt}
						widths={[768, 1200, 1600, 1700]}
						sizes="100vw"
						class="work-immersive__media u-depth"
					/>
					<div class="work-immersive__scrim" />
					{/* Pointer catch-light (P6.2 / D-37): a whisper-soft warm highlight tracks the pointer across
					    the architecture, a subtle "light on the building" mouse interaction (7.64/7.65). Desktop
					    fine-pointer only, opacity 0 until hover, script-set position; non-essential (no JS / touch /
					    reduced-motion → simply absent, plate fully intact). */}
					<div class="work-immersive__glow" aria-hidden="true" />
					<div class="work-immersive__caption u-container">
						<div class="work-immersive__caption-inner">
							<p class="t-eyebrow t-eyebrow--accent">
								{categoryLabel[featured.data.category]}
								{featured.data.location && <> &middot; {featured.data.location}</>}
							</p>
							<h3 class="t-display work-immersive__name">{featured.data.title}</h3>
							<span class="link-arrow work-immersive__cue">
								Bekijk project
								<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
							</span>
						</div>
					</div>
				</a>
			)
		}

		{
			/* Quiet counterpoint: the remaining projects drop to a small contained pair, so the scale
			   contrast with the immersive plate above is the point (loud → quiet), not two equal grids. */
		}
		<div class="u-container work__stack">
			{
				secondary.map((project, i) => (
					<a
						class="work-plate u-settle"
						href={`/portfolio/${project.id}/`}
						style={`--settle-rise: 1.2rem; animation-range: entry ${4 + i * 6}% entry ${44 + i * 6}%`}
					>
						<Media
							src={project.data.coverImage}
							alt={project.data.coverImageAlt}
							widths={[400, 700, 1000]}
							sizes="(min-width: 52rem) 46vw, 100vw"
							class="work-plate__media"
						/>
						<div class="work-plate__caption">
							<p class="t-eyebrow">
								{categoryLabel[project.data.category]}
								{project.data.location && <> &middot; {project.data.location}</>}
							</p>
							<h3 class="t-h3 work-plate__name">{project.data.title}</h3>
						</div>
					</a>
				))
			}
		</div>
	</Section>

	<!-- SPECIALISATIES (13.17 / 13.19). The two disciplines as an asymmetric photographic diptych, different
	     ratios, different weights, a shared approach, NOT two equal cards. The two PHOTOGRAPHS carry this beat
	     on the base-dark surface (images as the light source, 6.16). Each opens its service page. -->
	<Section as="section" class="spec-sec">
		<div class="spec">
		<p class="t-eyebrow t-eyebrow--accent">Specialisaties</p>
		<h2 class="t-display spec__title">Twee disciplines, één benadering.</h2>
		<div class="spec__grid">
			<a class="spec-card spec-card--arch u-settle" href="/diensten/architectuurfotografie/">
				<Media
					src={amersfoortImg}
					alt="Een historische torenspits met de Onze Lieve Vrouwetoren van Amersfoort erachter, tegen een dramatische bewolkte lucht."
					widths={[400, 700, 900]}
					sizes="(min-width: 60rem) 38vw, 100vw"
					ratio="3/4"
					position="center"
					class="spec-card__media"
					data-ptilt="10"
				/>
				<div class="spec-card__text">
					<h3 class="t-h3 spec-card__name">Architectuurfotografie</h3>
					<p class="spec-card__desc">
						Gebouwen en exterieurs, waarin structuur, proportie, licht en lijn tot hun recht komen
						van monumenten tot moderne architectuur.
					</p>
					<span class="link-arrow spec-card__link">
						Bekijk architectuurfotografie
						<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
					</span>
				</div>
			</a>
			<a class="spec-card spec-card--int u-settle" href="/diensten/interieurfotografie/" style="--settle-rise: 1.9rem; animation-range: entry 10% entry 50%">
				<Media
					src={eemhuisImg}
					alt="De leeszaal van het Eemhuis in Amersfoort met een golvend, verlicht plafond boven warme houten leestafels."
					widths={[400, 800, 1100]}
					sizes="(min-width: 60rem) 50vw, 100vw"
					ratio="4/3"
					position="center"
					class="spec-card__media"
					data-ptilt="12"
				/>
				<div class="spec-card__text">
					<h3 class="t-h3 spec-card__name">Interieurfotografie</h3>
					<p class="spec-card__desc">
						Ruimtes waarin sfeer, materiaal en functie samenkomen, van woningen en kantoren tot
						publieke gebouwen, in bestaand en zorgvuldig aangevuld licht.
					</p>
					<span class="link-arrow spec-card__link">
						Bekijk interieurfotografie
						<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
					</span>
				</div>
			</a>
		</div>
		</div>
	</Section>

	<!-- WERKWIJZE / VERTROUWEN (13.13 vertrouwen en werkwijze; P4 correction #4, D-23). Transformed from Leo's
	     own on-location service copy, a restrained enumerated method, not icon cards. The light plane is retired:
	     this is now a distinct DARK chapter, stepped up one tint to ink-850 (`surface`), a subtle full-bleed
	     tonal lift (6.9) between the base-dark specialisaties above and the base-dark CTA below, with monumental
	     gold numerals carrying the scale contrast the light card used to. Full-width tonal step, not a panel. -->
	<Section as="section" surface="surface" class="method-sec">
		<div class="method">
		<div class="method__head">
			<p class="t-eyebrow t-eyebrow--accent">Werkwijze</p>
			<h2 class="t-h2 method__title">Rustig, precies, altijd op locatie.</h2>
		</div>
		<ol class="method__list">
			<li class="method__item u-rise-linked" style="animation-range: entry 0% entry 58%">
				<span class="method__num">01</span>
				<div>
					<h3 class="t-h4 method__name">Fotografie op locatie</h3>
					<p class="method__desc">
						De opnames vinden altijd plaats bij de opdrachtgever, van particuliere woning tot kantoor,
						horeca, zorginstelling of publiek gebouw.
					</p>
				</div>
			</li>
			<li class="method__item u-rise-linked" style="animation-range: entry 8% entry 66%">
				<span class="method__num">02</span>
				<div>
					<h3 class="t-h4 method__name">Doordacht voorbereid</h3>
					<p class="method__desc">
						Vooraf bespreken we welke ruimtes in beeld komen en waarvoor de beelden worden gebruikt. Op
						basis daarvan wordt routing, belichting en het beste tijdstip van de dag bepaald.
					</p>
				</div>
			</li>
			<li class="method__item u-rise-linked" style="animation-range: entry 16% entry 74%">
				<span class="method__num">03</span>
				<div>
